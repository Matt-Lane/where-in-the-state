@using OregonGeographyGame.Models
@using OregonGeographyGame.Services
@inject IJSRuntime JS
@implements IDisposable

<div class="map-wrap">
<svg viewBox="@_viewport.ViewBox"
     class="map-svg"
     role="img"
     aria-label="Map of the state with county boundaries. Click the county you think is named. Pinch to zoom, drag to pan when zoomed."
     @ref="_svgRef"
     @onpointerdown="OnPointerDown"
     @onpointermove="OnPointerMove"
     @onpointerup="OnPointerUp"
     @onpointercancel="OnPointerCancel">
    @* State outline *@
    @foreach (var feature in Outline)
    {
        @foreach (var ring in feature.Parts)
        {
            <polygon points="@PointsAttribute(ring)"
                     class="map-outline" />
        }
    }

    @* Landmarks, by layer (toggles are display-only; they never affect scoring) *@
    @foreach (var feature in Landmarks)
    {
        if (!IsLayerVisible(feature.Layer))
        {
            continue;
        }

        @foreach (var part in feature.Parts)
        {
            if (feature.Kind == "Polygon")
            {
                <polygon points="@PointsAttribute(part)"
                         class="map-lake" />
            }
            else
            {
                <polyline points="@PointsAttribute(part)"
                          fill="none"
                          class="@LandmarkCssClass(feature.Layer)" />
            }
        }
    }

    @* The grid of counties: every county boundary drawn over the blank map,
       so the counties read as regions to pick from. County lines are NOT
       drawn in the other modes — here they are the point of the game. *@
    @foreach (var (county, rings) in _countySvgRings)
    {
        @foreach (var ring in rings)
        {
            <polygon points="@SvgPointsAttribute(ring)"
                     class="county-boundary" />
        }
    }

    @* The selected county, highlighted in blue while placing. *@
    @if (SelectedCounty is not null && !Revealed)
    {
        @foreach (var ring in SvgRingsFor(SelectedCounty))
        {
            <polygon points="@SvgPointsAttribute(ring)"
                     class="county-selected" />
        }
    }

    @* Reveal: the true county in green. If the player picked a different
       county, that one is shown in rust next to it. *@
    @if (Revealed && TrueCounty is not null)
    {
        @foreach (var ring in SvgRingsFor(TrueCounty))
        {
            <polygon points="@SvgPointsAttribute(ring)"
                     class="county-true" />
        }
        @CountyLabel(TrueCounty)
    }
    @if (Revealed && SelectedCounty is not null && TrueCounty is not null
        && !string.Equals(SelectedCounty.Name, TrueCounty.Name, StringComparison.Ordinal))
    {
        @foreach (var ring in SvgRingsFor(SelectedCounty))
        {
            <polygon points="@SvgPointsAttribute(ring)"
                     class="county-wrong" />
        }
    }
</svg>

@* Reset view: only shown once zoomed in, so the player can always get
   back to the full map. Small and in the corner so it never pushes the
   game off one screen. *@
@if (_viewport.IsZoomed)
{
    <button type="button"
            class="map-reset-view"
            aria-label="Reset map view to the full state"
            @onclick="ResetView">Reset view</button>
}

@* A small Confirm bubble next to the selected county, like the city pin's
   bubble and the puzzle piece's bubble, so the player can confirm right
   where they clicked. Positioned in percentages of the map wrapper via
   the current viewBox, so it tracks the county at any zoom or pan.
   Hidden while the county's centre is outside the visible window. *@
@if (Interactive && !Revealed && SelectedCounty is not null && IsSelectionInView())
{
    var (cx, cy) = CountyCentroidSvg(SelectedCounty);
    var (leftPct, topPctRaw) = _viewport.ToPercent(cx, cy);
    var topPct = Math.Clamp(topPctRaw, 4, 96);
    var flipped = (cx - _viewport.X) > _viewport.Width * 0.75;
    <button type="button"
            class="pin-confirm@(flipped ? " flipped" : "")"
            style="left: @leftPct.ToString("F2")%; top: @topPct.ToString("F2")%;"
            aria-label="Confirm selection"
            @onclick="OnConfirmClicked">Confirm</button>
}
</div>

@code {
    [Parameter] public IReadOnlyList<MapFeature> Outline { get; set; } = [];
    [Parameter] public IReadOnlyList<MapFeature> Landmarks { get; set; } = [];

    [Parameter] public bool ShowInterstates { get; set; } = true;
    [Parameter] public bool ShowHighways { get; set; } = true;
    [Parameter] public bool ShowRivers { get; set; } = true;
    [Parameter] public bool ShowLakes { get; set; } = true;

    /// <summary>All counties in the pack, drawn as the boundary grid.</summary>
    [Parameter] public IReadOnlyList<MapFeature> Counties { get; set; } = [];

    /// <summary>The county the player has selected this round, if any.</summary>
    [Parameter] public MapFeature? SelectedCounty { get; set; }

    /// <summary>The true county; only rendered once <see cref="Revealed"/> is true.</summary>
    [Parameter] public MapFeature? TrueCounty { get; set; }

    [Parameter] public bool Revealed { get; set; }
    [Parameter] public bool Interactive { get; set; } = true;

    /// <summary>
    /// A new round (from the parent's round index), so every round begins
    /// at the full view — a zoomed view is never carried across rounds.
    /// </summary>
    [Parameter] public int RoundKey { get; set; }

    /// <summary>Raised when the player clicks a county on the map, or null
    /// when the click lands outside all counties (which clears the selection).</summary>
    [Parameter] public EventCallback<MapFeature?> OnCountySelected { get; set; }

    /// <summary>Raised when the player taps the Confirm bubble next to the selection.</summary>
    [Parameter] public EventCallback OnConfirmClicked { get; set; }

    private ElementReference _svgRef;

    // The visible window onto the map (pinch-to-zoom / pan). The SVG's
    // viewBox is bound to it.
    private readonly MapViewport _viewport = new();

    // Active pointers by pointerId, for pinch (two pointers) and pan
    // (one pointer, when zoomed). The SVG's bounding rect, measured when
    // a gesture starts and cached for it, so moves need no JS interop.
    private readonly Dictionary<long, (double ClientX, double ClientY)> _pointers = new();
    private double[]? _svgRect;

    // Tap vs drag: the pointer-down position, whether it has moved past
    // the tap threshold, and whether this gesture ever pinched (a pinch
    // never selects a county). A tap is a pointerup with minimal movement.
    private (double ClientX, double ClientY) _downPos;
    private bool _downMoved;
    private bool _pinchGesture;

    // Pinch state: the finger distance at the previous move, for the
    // incremental ratio (see OnPointerMove). The anchor is recomputed
    // from the current midpoint on every move, so the zoom tracks the
    // fingers and is immune to a stale baseline.
    private double _pinchPrevDist;

    // The animation-frame loop for viewport smoothing (see MapViewport):
    // pointer moves only update the TARGET window; a requestAnimationFrame
    // callback eases the displayed window toward it and re-renders. This
    // keeps viewBox updates on the display refresh and filters finger
    // jitter. The loop is driven from JS (requestViewportFrame in
    // index.html) calling ViewportFrame on this component.
    private DotNetObjectReference<NameTheCountyMapView>? _viewportFrameRef;
    private bool _viewportFramePending;

    // Pan state: the last pointer position, for per-move deltas.
    private (double ClientX, double ClientY) _panLast;

    private int _lastRoundKey = -1;
    private bool _lastRevealed;

    // Every county's rings in SVG coordinates, cached when the county list
    // changes. Counties tile the state without overlapping, so a click lands
    // in at most one of them.
    private List<(MapFeature County, List<IReadOnlyList<(double X, double Y)>> Rings)> _countySvgRings = [];

    protected override void OnParametersSet()
    {
        // A new round, or the reveal, returns to the full map: the
        // reveal counties read in full-state context, and no zoom is ever
        // carried into the next round.
        if (RoundKey != _lastRoundKey)
        {
            _lastRoundKey = RoundKey;
            _viewport.Reset();
        }
        if (Revealed && !_lastRevealed)
        {
            _viewport.Reset();
        }
        _lastRevealed = Revealed;

        if (Counties.Count != _countySvgRings.Count)
        {
            _countySvgRings = Counties
                .Select(c => (County: c, Rings: ProjectRings(c.Parts)))
                .ToList();
        }
    }

    private void ResetView()
    {
        _viewport.Reset();
    }

    protected override void OnInitialized()
    {
        _viewportFrameRef = DotNetObjectReference.Create(this);
    }

    public void Dispose()
    {
        _viewportFrameRef?.Dispose();
    }

    private void ScheduleViewportFrame()
    {
        // One frame at a time: if a frame is already queued, the loop
        // picks up the latest target when it runs. Fire-and-forget: the
        // JS side never throws (requestViewportFrame is guarded).
        if (_viewportFramePending || _viewportFrameRef is null)
        {
            return;
        }
        _viewportFramePending = true;
        _ = JS.InvokeVoidAsync("whereInTheState.requestViewportFrame", _viewportFrameRef);
    }

    /// <summary>
    /// One animation frame of viewport smoothing, called from
    /// requestAnimationFrame via JS interop. Eases the displayed window
    /// toward the target and re-renders; schedules another frame while
    /// the window is still moving.
    /// </summary>
    [JSInvokable]
    public void ViewportFrame()
    {
        _viewportFramePending = false;
        if (_viewport.StepTowardsTarget())
        {
            StateHasChanged();
        }
        if (_viewport.IsEasing)
        {
            ScheduleViewportFrame();
        }
    }

    private bool IsSelectionInView()
    {
        if (SelectedCounty is null)
        {
            return false;
        }

        var (cx, cy) = CountyCentroidSvg(SelectedCounty);
        return _viewport.Contains(cx, cy);
    }

    private List<IReadOnlyList<(double X, double Y)>> SvgRingsFor(MapFeature county)
    {
        var match = _countySvgRings.FirstOrDefault(e =>
            string.Equals(e.County.Name, county.Name, StringComparison.Ordinal));
        return match.Rings ?? ProjectRings(county.Parts);
    }

    private static List<IReadOnlyList<(double X, double Y)>> ProjectRings(
        IReadOnlyList<IReadOnlyList<(double Lon, double Lat)>> parts)
    {
        var result = new List<IReadOnlyList<(double X, double Y)>>();
        foreach (var ring in parts)
        {
            var projected = new List<(double X, double Y)>(ring.Count);
            foreach (var (lon, lat) in ring)
            {
                projected.Add(MapProjection.LatLonToSvg(lat, lon));
            }
            result.Add(projected);
        }

        return result;
    }

    private async Task OnPointerDown(PointerEventArgs e)
    {
        if (!Interactive || Revealed)
        {
            return;
        }

        // Measure the SVG's bounding rect when the first pointer goes
        // down (ClientX/Y are viewport-relative, so the rect is what
        // converts them to viewBox units). If the measurement fails,
        // ignore the gesture rather than selecting the wrong county.
        if (_pointers.Count == 0)
        {
            try
            {
                var rect = await JS.InvokeAsync<double[]>("whereInTheState.svgRect", _svgRef);
                if (rect is not { Length: 4 } || rect[2] <= 0 || rect[3] <= 0)
                {
                    return;
                }
                _svgRect = rect;
            }
            catch
            {
                return;
            }
        }

        // Capture the pointer so moves keep arriving even if the finger
        // slides off the map mid-gesture.
        try
        {
            await JS.InvokeVoidAsync("whereInTheState.capturePointer", _svgRef, e.PointerId);
        }
        catch
        {
            // Pointer capture is best-effort; gestures still work without it.
        }

        _pointers[e.PointerId] = (e.ClientX, e.ClientY);

        if (_pointers.Count == 2)
        {
            // Second finger down: this gesture is a pinch. Only the
            // finger distance is captured — the zoom is applied
            // incrementally from it (see OnPointerMove), and the anchor
            // is recomputed from the current midpoint on every move.
            var pts = _pointers.Values.ToArray();
            _pinchPrevDist = Math.Sqrt((pts[0].ClientX - pts[1].ClientX) * (pts[0].ClientX - pts[1].ClientX) + (pts[0].ClientY - pts[1].ClientY) * (pts[0].ClientY - pts[1].ClientY));
            _pinchGesture = true;
            return;
        }

        _downPos = (e.ClientX, e.ClientY);
        _downMoved = false;
        _panLast = (e.ClientX, e.ClientY);
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (!_pointers.TryGetValue(e.PointerId, out _) || _svgRect is null)
        {
            return;
        }

        _pointers[e.PointerId] = (e.ClientX, e.ClientY);

        if (_pointers.Count == 2 && _pinchGesture)
        {
            // Pinch: apply the INCREMENTAL change in finger distance to
            // the target viewBox, anchored at the CURRENT midpoint. Each
            // step is relative to the previous move's distance, so the
            // zoom is continuous and immune to a stale baseline, and the
            // anchor follows the fingers when they move asymmetrically.
            // The displayed window eases toward the target on the next
            // animation frame (see ViewportFrame) — it is not set here.
            var pts = _pointers.Values.ToArray();
            double dist = Math.Sqrt((pts[0].ClientX - pts[1].ClientX) * (pts[0].ClientX - pts[1].ClientX) + (pts[0].ClientY - pts[1].ClientY) * (pts[0].ClientY - pts[1].ClientY));
            if (dist > 0 && _pinchPrevDist > 0)
            {
                double midClientX = (pts[0].ClientX + pts[1].ClientX) / 2;
                double midClientY = (pts[0].ClientY + pts[1].ClientY) / 2;
                var (anchorSvgX, anchorSvgY) = _viewport.ClientToSvg(
                    midClientX, midClientY, _svgRect![0], _svgRect[1], _svgRect[2], _svgRect[3]);
                _viewport.ZoomAt(anchorSvgX, anchorSvgY,
                    midClientX, midClientY,
                    _svgRect[0], _svgRect[1], _svgRect[2], _svgRect[3],
                    _viewport.TargetWidth * _pinchPrevDist / dist);
                ScheduleViewportFrame();
            }
            _pinchPrevDist = dist;
            return;
        }

        // One finger: mark movement past the tap threshold, and pan when
        // zoomed in. At full view a drag does nothing — the county is
        // selected by a tap (pointerup), not by dragging.
        if (Math.Sqrt((e.ClientX - _downPos.ClientX) * (e.ClientX - _downPos.ClientX) + (e.ClientY - _downPos.ClientY) * (e.ClientY - _downPos.ClientY))
            > MapViewport.TapMoveThresholdPx)
        {
            _downMoved = true;
        }

        if (_pointers.Count == 1 && _viewport.IsZoomed)
        {
            // Pan moves the TARGET window; the displayed window eases
            // toward it on the next animation frame (see ViewportFrame).
            _viewport.Pan(e.ClientX - _panLast.ClientX, e.ClientY - _panLast.ClientY,
                _svgRect[2], _svgRect[3]);
            ScheduleViewportFrame();
        }

        _panLast = (e.ClientX, e.ClientY);
    }

    private async Task OnPointerUp(PointerEventArgs e)
    {
        if (!_pointers.Remove(e.PointerId))
        {
            return;
        }

        if (_pointers.Count == 1)
        {
            // One finger lifted mid-pinch: the gesture stays a pinch (no
            // tap on release), but the remaining finger becomes a fresh
            // single pointer, so it can pan from here.
            var remaining = _pointers.Values.First();
            _downPos = (remaining.ClientX, remaining.ClientY);
            _downMoved = false;
            _panLast = (remaining.ClientX, remaining.ClientY);
            return;
        }

        // Gesture over. Snap the displayed window to the target first,
        // so the tap (if any) resolves against the exact final view.
        _viewport.SnapToTarget();
        StateHasChanged();

        // A tap — one pointer, no pinch, minimal movement — selects the
        // county under it, converted with the CURRENT viewBox
        // (zoomed and panned).
        var rect = _svgRect;
        bool isTap = !_pinchGesture && !_downMoved && rect is not null;
        _pinchGesture = false;
        _svgRect = null;

        if (!isTap || !Interactive || Revealed)
        {
            return;
        }

        var (svgX, svgY) = _viewport.ClientToSvg(e.ClientX, e.ClientY,
            rect![0], rect[1], rect[2], rect[3]);
        await SelectCountyAt(svgX, svgY);
    }

    private void OnPointerCancel(PointerEventArgs e)
    {
        _pointers.Remove(e.PointerId);
        if (_pointers.Count == 0)
        {
            _pinchGesture = false;
            _svgRect = null;
            // Gesture over: snap the displayed window to the target.
            _viewport.SnapToTarget();
            StateHasChanged();
        }
    }

    private async Task SelectCountyAt(double svgX, double svgY)
    {
        // Find the county containing the tap. A tap outside the state
        // (ocean, a neighbouring state) is in no county and selects
        // nothing: clear any existing selection, so a stray tap outside
        // the state doesn't leave the previous county selected.
        foreach (var (county, rings) in _countySvgRings)
        {
            if (OverlapService.IsInsideAnyRing(svgX, svgY, rings))
            {
                await OnCountySelected.InvokeAsync(county);
                return;
            }
        }

        await OnCountySelected.InvokeAsync(null);
    }

    private (double X, double Y) CountyCentroidSvg(MapFeature county)
    {
        var rings = SvgRingsFor(county);
        double minX = double.MaxValue, minY = double.MaxValue;
        double maxX = double.MinValue, maxY = double.MinValue;
        foreach (var ring in rings)
        {
            foreach (var (x, y) in ring)
            {
                minX = Math.Min(minX, x); maxX = Math.Max(maxX, x);
                minY = Math.Min(minY, y); maxY = Math.Max(maxY, y);
            }
        }

        return ((minX + maxX) / 2, (minY + maxY) / 2);
    }

    private bool IsLayerVisible(string layer) => layer switch
    {
        "interstate" => ShowInterstates,
        "highway" => ShowHighways,
        "river" => ShowRivers,
        "lake" => ShowLakes,
        _ => true
    };

    private static string LandmarkCssClass(string layer) => layer switch
    {
        "interstate" => "map-interstate",
        "highway" => "map-highway",
        "river" => "map-river",
        _ => "map-landmark"
    };

    private static string PointsAttribute(IReadOnlyList<(double Lon, double Lat)> points)
    {
        var parts = new string[points.Count];
        for (int i = 0; i < points.Count; i++)
        {
            var (x, y) = MapProjection.LatLonToSvg(points[i].Lat, points[i].Lon);
            parts[i] = $"{x:F1},{y:F1}";
        }

        return string.Join(" ", parts);
    }

    private static string SvgPointsAttribute(IReadOnlyList<(double X, double Y)> points)
    {
        var parts = new string[points.Count];
        for (int i = 0; i < points.Count; i++)
        {
            parts[i] = $"{points[i].X:F1},{points[i].Y:F1}";
        }

        return string.Join(" ", parts);
    }

    private MarkupString CountyLabel(MapFeature county)
    {
        // The county name on the true county, like the city name label on
        // the reveal pin. Centred on the true county's bounding box,
        // clamped so long names don't run off the map.
        var rings = SvgRingsFor(county);
        double minX = double.MaxValue, minY = double.MaxValue;
        double maxX = double.MinValue, maxY = double.MinValue;
        foreach (var ring in rings)
        {
            foreach (var (x, y) in ring)
            {
                minX = Math.Min(minX, x); maxX = Math.Max(maxX, x);
                minY = Math.Min(minY, y); maxY = Math.Max(maxY, y);
            }
        }

        var labelX = Math.Clamp((minX + maxX) / 2, 90, 910);
        var labelY = Math.Clamp((minY + maxY) / 2, 30, 730);
        var name = System.Net.WebUtility.HtmlEncode(county.Name ?? "");
        return new MarkupString(
            $"<text x=\"{labelX:F1}\" y=\"{labelY:F1}\" class=\"map-label\">{name}</text>");
    }
}
