@using OregonGeographyGame.Models
@using OregonGeographyGame.Services
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="map-wrap">
<svg viewBox="@_viewport.ViewBox"
     class="map-svg"
     role="img"
     aria-label="Map of the state with county boundaries. Click the county you think is named. Pinch to zoom, drag to pan when zoomed."
     data-interactive="@(Interactive ? "true" : "false")"
     data-revealed="@(Revealed ? "true" : "false")"
     @ref="_svgRef">
    @* State outline *@
    @foreach (var feature in Outline)
    {
        @foreach (var ring in feature.Parts)
        {
            <polygon points="@PointsAttribute(ring)"
                     class="map-outline" />
        }
    }

    @* Landmarks, by layer (toggles are display-only; they never affect scoring) *@
    @foreach (var feature in Landmarks)
    {
        if (!IsLayerVisible(feature.Layer))
        {
            continue;
        }

        @foreach (var part in feature.Parts)
        {
            if (feature.Kind == "Polygon")
            {
                <polygon points="@PointsAttribute(part)"
                         class="map-lake" />
            }
            else
            {
                <polyline points="@PointsAttribute(part)"
                          fill="none"
                          class="@LandmarkCssClass(feature.Layer)" />
            }
        }
    }

    @* The grid of counties: every county boundary drawn over the blank map,
       so the counties read as regions to pick from. County lines are NOT
       drawn in the other modes — here they are the point of the game. *@
    @foreach (var (county, rings) in _countySvgRings)
    {
        @foreach (var ring in rings)
        {
            <polygon points="@SvgPointsAttribute(ring)"
                     class="county-boundary" />
        }
    }

    @* The selected county, highlighted in blue while placing. *@
    @if (SelectedCounty is not null && !Revealed)
    {
        @foreach (var ring in SvgRingsFor(SelectedCounty))
        {
            <polygon points="@SvgPointsAttribute(ring)"
                     class="county-selected" />
        }
    }

    @* Reveal: the true county in green. If the player picked a different
       county, that one is shown in rust next to it. *@
    @if (Revealed && TrueCounty is not null)
    {
        @foreach (var ring in SvgRingsFor(TrueCounty))
        {
            <polygon points="@SvgPointsAttribute(ring)"
                     class="county-true" />
        }
        @CountyLabel(TrueCounty)
    }
    @if (Revealed && SelectedCounty is not null && TrueCounty is not null
        && !string.Equals(SelectedCounty.Name, TrueCounty.Name, StringComparison.Ordinal))
    {
        @foreach (var ring in SvgRingsFor(SelectedCounty))
        {
            <polygon points="@SvgPointsAttribute(ring)"
                     class="county-wrong" />
        }
    }
</svg>

@* Reset view: only shown once zoomed in, so the player can always get
   back to the full map. Small and in the corner so it never pushes the
   game off one screen. *@
@if (_viewport.IsZoomed)
{
    <button type="button"
            class="map-reset-view"
            aria-label="Reset map view to the full state"
            @onclick="ResetView">Reset view</button>
}

@* A small Confirm bubble next to the selected county, like the city pin's
   bubble and the puzzle piece's bubble, so the player can confirm right
   where they clicked. Positioned in percentages of the map wrapper via
   the current viewBox, so it tracks the county at any zoom or pan.
   Hidden while the county's centre is outside the visible window. *@
@if (Interactive && !Revealed && SelectedCounty is not null && IsSelectionInView())
{
    var (cx, cy) = CountyCentroidSvg(SelectedCounty);
    var (leftPct, topPctRaw) = _viewport.ToPercent(cx, cy);
    var topPct = Math.Clamp(topPctRaw, 4, 96);
    var flipped = (cx - _viewport.X) > _viewport.Width * 0.75;
    <button type="button"
            class="pin-confirm@(flipped ? " flipped" : "")"
            style="left: @leftPct.ToString("F2")%; top: @topPct.ToString("F2")%;"
            aria-label="Confirm selection"
            @onclick="OnConfirmClicked">Confirm</button>
}
</div>

@code {
    [Parameter] public IReadOnlyList<MapFeature> Outline { get; set; } = [];
    [Parameter] public IReadOnlyList<MapFeature> Landmarks { get; set; } = [];

    [Parameter] public bool ShowInterstates { get; set; } = true;
    [Parameter] public bool ShowHighways { get; set; } = true;
    [Parameter] public bool ShowRivers { get; set; } = true;
    [Parameter] public bool ShowLakes { get; set; } = true;

    /// <summary>All counties in the pack, drawn as the boundary grid.</summary>
    [Parameter] public IReadOnlyList<MapFeature> Counties { get; set; } = [];

    /// <summary>The county the player has selected this round, if any.</summary>
    [Parameter] public MapFeature? SelectedCounty { get; set; }

    /// <summary>The true county; only rendered once <see cref="Revealed"/> is true.</summary>
    [Parameter] public MapFeature? TrueCounty { get; set; }

    [Parameter] public bool Revealed { get; set; }
    [Parameter] public bool Interactive { get; set; } = true;

    /// <summary>
    /// A new round (from the parent's round index), so every round begins
    /// at the full view — a zoomed view is never carried across rounds.
    /// </summary>
    [Parameter] public int RoundKey { get; set; }

    /// <summary>Raised when the player clicks a county on the map, or null
    /// when the click lands outside all counties (which clears the selection).</summary>
    [Parameter] public EventCallback<MapFeature?> OnCountySelected { get; set; }

    /// <summary>Raised when the player taps the Confirm bubble next to the selection.</summary>
    [Parameter] public EventCallback OnConfirmClicked { get; set; }

    private ElementReference _svgRef;

    // The visible window onto the map (pinch-to-zoom / pan). The SVG's
    // viewBox is bound to it. The live gesture is owned entirely by JS
    // (mapGesture in index.html): it writes the viewBox attribute
    // directly during a pinch/pan and reports the final viewBox once,
    // when the gesture ends (see GestureEnded). This class only ever
    // holds the synced window — no .NET state changes mid-gesture, so
    // no re-render can snap the viewBox back while the fingers move.
    private readonly MapViewport _viewport = new();

    // The .NET reference JS calls back into (GestureEnded), and whether
    // the SVG has rendered (JS attach/reset calls are skipped before it).
    private DotNetObjectReference<NameTheCountyMapView>? _mapGestureRef;
    private bool _hasRendered;

    private int _lastRoundKey = -1;
    private bool _lastRevealed;

    // Every county's rings in SVG coordinates, cached when the county list
    // changes. Counties tile the state without overlapping, so a click lands
    // in at most one of them.
    private List<(MapFeature County, List<IReadOnlyList<(double X, double Y)>> Rings)> _countySvgRings = [];

    protected override void OnParametersSet()
    {
        // A new round, or the reveal, returns to the full map: the
        // reveal counties read in full-state context, and no zoom is ever
        // carried into the next round.
        if (RoundKey != _lastRoundKey)
        {
            _lastRoundKey = RoundKey;
            ResetViewport();
        }
        if (Revealed && !_lastRevealed)
        {
            ResetViewport();
        }
        _lastRevealed = Revealed;

        if (Counties.Count != _countySvgRings.Count)
        {
            _countySvgRings = Counties
                .Select(c => (County: c, Rings: ProjectRings(c.Parts)))
                .ToList();
        }
    }

    private void ResetView()
    {
        ResetViewport();
    }

    /// <summary>
    /// Reset the window to the full map, in .NET and in JS: the JS
    /// controller's easing loop is cancelled and its viewport returns
    /// to full, so a reset can never be overwritten by a frame still
    /// in flight. The Razor viewBox binding writes the full view on
    /// the next render, so the two agree.
    /// </summary>
    private void ResetViewport()
    {
        _viewport.Reset();
        if (_hasRendered)
        {
            _ = JS.InvokeVoidAsync("whereInTheState.mapGestureReset", _svgRef);
        }
    }

    protected override void OnInitialized()
    {
        _mapGestureRef = DotNetObjectReference.Create(this);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _hasRendered = true;
            _ = JS.InvokeVoidAsync("whereInTheState.mapGestureAttach", _svgRef, _mapGestureRef, "name-the-county");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hasRendered)
        {
            try
            {
                await JS.InvokeVoidAsync("whereInTheState.mapGestureDetach", _svgRef);
            }
            catch
            {
                // Best-effort: the element is going away anyway.
            }
        }
        _mapGestureRef?.Dispose();
    }

    /// <summary>
    /// Called by the JS gesture controller exactly once, when a gesture
    /// ends, with the final viewBox — and a tap, if the gesture was one
    /// (as SVG coordinates, converted by JS with the final view). This
    /// is the only moment .NET learns about a gesture, so there is no
    /// re-render or interop while the fingers are moving.
    /// </summary>
    [JSInvokable]
    public async Task GestureEnded(double x, double y, double width, double height,
        double? tapSvgX, double? tapSvgY, double? pieceDx, double? pieceDy)
    {
        _viewport.SyncTo(x, y, width);
        if (tapSvgX.HasValue && tapSvgY.HasValue)
        {
            await SelectCountyAt(tapSvgX.Value, tapSvgY.Value);
        }
        StateHasChanged();
    }

    private bool IsSelectionInView()
    {
        if (SelectedCounty is null)
        {
            return false;
        }

        var (cx, cy) = CountyCentroidSvg(SelectedCounty);
        return _viewport.Contains(cx, cy);
    }

    private List<IReadOnlyList<(double X, double Y)>> SvgRingsFor(MapFeature county)
    {
        var match = _countySvgRings.FirstOrDefault(e =>
            string.Equals(e.County.Name, county.Name, StringComparison.Ordinal));
        return match.Rings ?? ProjectRings(county.Parts);
    }

    private static List<IReadOnlyList<(double X, double Y)>> ProjectRings(
        IReadOnlyList<IReadOnlyList<(double Lon, double Lat)>> parts)
    {
        var result = new List<IReadOnlyList<(double X, double Y)>>();
        foreach (var ring in parts)
        {
            var projected = new List<(double X, double Y)>(ring.Count);
            foreach (var (lon, lat) in ring)
            {
                projected.Add(MapProjection.LatLonToSvg(lat, lon));
            }
            result.Add(projected);
        }

        return result;
    }

    private async Task SelectCountyAt(double svgX, double svgY)
    {
        // Find the county containing the tap. A tap outside the state
        // (ocean, a neighbouring state) is in no county and selects
        // nothing: clear any existing selection, so a stray tap outside
        // the state doesn't leave the previous county selected.
        foreach (var (county, rings) in _countySvgRings)
        {
            if (OverlapService.IsInsideAnyRing(svgX, svgY, rings))
            {
                await OnCountySelected.InvokeAsync(county);
                return;
            }
        }

        await OnCountySelected.InvokeAsync(null);
    }

    private (double X, double Y) CountyCentroidSvg(MapFeature county)
    {
        var rings = SvgRingsFor(county);
        double minX = double.MaxValue, minY = double.MaxValue;
        double maxX = double.MinValue, maxY = double.MinValue;
        foreach (var ring in rings)
        {
            foreach (var (x, y) in ring)
            {
                minX = Math.Min(minX, x); maxX = Math.Max(maxX, x);
                minY = Math.Min(minY, y); maxY = Math.Max(maxY, y);
            }
        }

        return ((minX + maxX) / 2, (minY + maxY) / 2);
    }

    private bool IsLayerVisible(string layer) => layer switch
    {
        "interstate" => ShowInterstates,
        "highway" => ShowHighways,
        "river" => ShowRivers,
        "lake" => ShowLakes,
        _ => true
    };

    private static string LandmarkCssClass(string layer) => layer switch
    {
        "interstate" => "map-interstate",
        "highway" => "map-highway",
        "river" => "map-river",
        _ => "map-landmark"
    };

    private static string PointsAttribute(IReadOnlyList<(double Lon, double Lat)> points)
    {
        var parts = new string[points.Count];
        for (int i = 0; i < points.Count; i++)
        {
            var (x, y) = MapProjection.LatLonToSvg(points[i].Lat, points[i].Lon);
            parts[i] = $"{x:F1},{y:F1}";
        }

        return string.Join(" ", parts);
    }

    private static string SvgPointsAttribute(IReadOnlyList<(double X, double Y)> points)
    {
        var parts = new string[points.Count];
        for (int i = 0; i < points.Count; i++)
        {
            parts[i] = $"{points[i].X:F1},{points[i].Y:F1}";
        }

        return string.Join(" ", parts);
    }

    private MarkupString CountyLabel(MapFeature county)
    {
        // The county name on the true county, like the city name label on
        // the reveal pin. Centred on the true county's bounding box,
        // clamped so long names don't run off the map.
        var rings = SvgRingsFor(county);
        double minX = double.MaxValue, minY = double.MaxValue;
        double maxX = double.MinValue, maxY = double.MinValue;
        foreach (var ring in rings)
        {
            foreach (var (x, y) in ring)
            {
                minX = Math.Min(minX, x); maxX = Math.Max(maxX, x);
                minY = Math.Min(minY, y); maxY = Math.Max(maxY, y);
            }
        }

        var labelX = Math.Clamp((minX + maxX) / 2, 90, 910);
        var labelY = Math.Clamp((minY + maxY) / 2, 30, 730);
        var name = System.Net.WebUtility.HtmlEncode(county.Name ?? "");
        return new MarkupString(
            $"<text x=\"{labelX:F1}\" y=\"{labelY:F1}\" class=\"map-label\">{name}</text>");
    }
}
