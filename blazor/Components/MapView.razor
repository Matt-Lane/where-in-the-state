@using OregonGeographyGame.Models
@using OregonGeographyGame.Services
@inject IJSRuntime JS

<div class="map-wrap">
<svg viewBox="@_viewport.ViewBox"
     class="map-svg"
     role="img"
     aria-label="Blank map of the state. No city names are shown. Pinch to zoom, drag to pan when zoomed."
     @ref="_svgRef"
     @onpointerdown="OnPointerDown"
     @onpointermove="OnPointerMove"
     @onpointerup="OnPointerUp"
     @onpointercancel="OnPointerCancel">
    @* State outline *@
    @foreach (var feature in Outline)
    {
        @foreach (var ring in feature.Parts)
        {
            <polygon points="@PointsAttribute(ring)"
                     class="map-outline" />
        }
    }

    @* Landmarks, by layer (toggles are display-only; they never affect scoring) *@
    @foreach (var feature in Landmarks)
    {
        if (!IsLayerVisible(feature.Layer))
        {
            continue;
        }

        @foreach (var part in feature.Parts)
        {
            if (feature.Kind == "Polygon")
            {
                <polygon points="@PointsAttribute(part)"
                         class="map-lake" />
            }
            else
            {
                <polyline points="@PointsAttribute(part)"
                          fill="none"
                          class="@LandmarkCssClass(feature.Layer)" />
            }
        }
    }

    @* Reveal: dashed line between guess and true location *@
    @if (Revealed && GuessLatitude is not null && GuessLongitude is not null
        && TrueLatitude is not null && TrueLongitude is not null)
    {
        var (gx, gy) = MapProjection.LatLonToSvg(GuessLatitude.Value, GuessLongitude.Value);
        var (tx, ty) = MapProjection.LatLonToSvg(TrueLatitude.Value, TrueLongitude.Value);
        @* A white underlay first so the dashed line reads over roads/rivers *@
        <line x1="@gx" y1="@gy" x2="@tx" y2="@ty" class="map-connect-halo" />
        <line x1="@gx" y1="@gy" x2="@tx" y2="@ty" class="map-connect-line" />
    }

    @* True location pin (green) — only after reveal. Drawn large with a
       halo and a name label so it reads at the one-screen map size. *@
    @if (Revealed && TrueLatitude is not null && TrueLongitude is not null)
    {
        var (tx, ty) = MapProjection.LatLonToSvg(TrueLatitude.Value, TrueLongitude.Value);
        <g class="pin pin-true">
            <circle cx="@tx" cy="@ty" r="19" class="pin-halo" />
            <circle cx="@tx" cy="@ty" r="13" />
            <circle cx="@tx" cy="@ty" r="4.5" class="pin-dot" />
            <line x1="@(tx - 21)" y1="@ty" x2="@(tx - 6)" y2="@ty" class="pin-cross" />
            <line x1="@(tx + 6)" y1="@ty" x2="@(tx + 21)" y2="@ty" class="pin-cross" />
            <line x1="@tx" y1="@(ty - 21)" x2="@tx" y2="@(ty - 6)" class="pin-cross" />
            <line x1="@tx" y1="@(ty + 6)" x2="@tx" y2="@(ty + 21)" class="pin-cross" />
        </g>
        @if (TrueName is not null)
        {
            @TrueLabel(tx, ty)
        }
    }

    @* Guess pin: provisional (blue) while placing, revealed guess (red) after confirm *@
    @if (GuessLatitude is not null && GuessLongitude is not null)
    {
        var (gx, gy) = MapProjection.LatLonToSvg(GuessLatitude.Value, GuessLongitude.Value);
        <g class="@(Revealed ? "pin pin-guess" : "pin pin-provisional")">
            <circle cx="@gx" cy="@gy" r="11" />
            <circle cx="@gx" cy="@gy" r="4" class="pin-dot" />
        </g>
    }
</svg>

@* Reset view: only shown once zoomed in, so the player can always get
   back to the full map. Small and in the corner so it never pushes the
   game off one screen. *@
@if (_viewport.IsZoomed)
{
    <button type="button"
            class="map-reset-view"
            aria-label="Reset map view to the full state"
            @onclick="ResetView">Reset view</button>
}

@* A small Confirm bubble next to the pin while placing, so the player
   doesn't have to travel back to the controls row. It sits to the
   right of the pin (flipped to the left near the right edge) and is
   positioned in percentages of the map wrapper, which is exactly the
   SVG's box, so it tracks the pin at any map size — and at any zoom or
   pan, via the current viewBox. Hidden while the pin is outside the
   visible window (the controls-row Confirm is the fallback then). *@
@if (Interactive && !Revealed && GuessLatitude is not null && GuessLongitude is not null && IsGuessInView())
{
    var (gx, gy) = MapProjection.LatLonToSvg(GuessLatitude.Value, GuessLongitude.Value);
    var (leftPct, topPctRaw) = _viewport.ToPercent(gx, gy);
    var topPct = Math.Clamp(topPctRaw, 4, 96);
    var flipped = (gx - _viewport.X) > _viewport.Width * 0.75;
    <button type="button"
            class="pin-confirm@(flipped ? " flipped" : "")"
            style="left: @leftPct.ToString("F2")%; top: @topPct.ToString("F2")%;"
            aria-label="Confirm guess"
            @onclick="OnConfirmClicked">Confirm</button>
}
</div>

@code {
    [Parameter] public IReadOnlyList<MapFeature> Outline { get; set; } = [];
    [Parameter] public IReadOnlyList<MapFeature> Landmarks { get; set; } = [];

    [Parameter] public bool ShowInterstates { get; set; } = true;
    [Parameter] public bool ShowHighways { get; set; } = true;
    [Parameter] public bool ShowRivers { get; set; } = true;
    [Parameter] public bool ShowLakes { get; set; } = true;

    /// <summary>Provisional (or confirmed) guess, if the player has placed a pin.</summary>
    [Parameter] public double? GuessLatitude { get; set; }
    [Parameter] public double? GuessLongitude { get; set; }

    /// <summary>True city location; only rendered once <see cref="Revealed"/> is true.</summary>
    [Parameter] public double? TrueLatitude { get; set; }
    [Parameter] public double? TrueLongitude { get; set; }

    /// <summary>Name of the true city, shown as a label on the reveal pin.</summary>
    [Parameter] public string? TrueName { get; set; }

    [Parameter] public bool Revealed { get; set; }
    [Parameter] public bool Interactive { get; set; } = true;

    /// <summary>
    /// A new round (from the parent's round index), so every round begins
    /// at the full view — a zoomed view is never carried across rounds.
    /// </summary>
    [Parameter] public int RoundKey { get; set; }

    [Parameter] public EventCallback<(double Latitude, double Longitude)> OnMapClicked { get; set; }

    /// <summary>Raised when the player taps the Confirm bubble next to the pin.</summary>
    [Parameter] public EventCallback OnConfirmClicked { get; set; }

    private ElementReference _svgRef;

    // The visible window onto the map (pinch-to-zoom / pan). The SVG's
    // viewBox is bound to it.
    private readonly MapViewport _viewport = new();

    // Active pointers by pointerId, for pinch (two pointers) and pan
    // (one pointer, when zoomed). The SVG's bounding rect, measured when
    // a gesture starts and cached for it, so moves need no JS interop.
    private readonly Dictionary<long, (double ClientX, double ClientY)> _pointers = new();
    private double[]? _svgRect;

    // Tap vs drag: the pointer-down position, whether it has moved past
    // the tap threshold, and whether this gesture ever pinched (a pinch
    // never places a pin). A tap is a pointerup with minimal movement.
    private (double ClientX, double ClientY) _downPos;
    private bool _downMoved;
    private bool _pinchGesture;

    // Pinch state, captured when the second pointer goes down: the
    // distance and viewBox width at the start, and the pinch midpoint —
    // in both SVG units (the anchor, which stays put) and client pixels.
    private double _pinchStartDist;
    private double _pinchStartWidth;
    private double _pinchAnchorSvgX;
    private double _pinchAnchorSvgY;
    private double _pinchAnchorClientX;
    private double _pinchAnchorClientY;

    // Pan state: the last pointer position, for per-move deltas.
    private (double ClientX, double ClientY) _panLast;

    private int _lastRoundKey = -1;
    private bool _lastRevealed;

    protected override void OnParametersSet()
    {
        // A new round, or the reveal, returns to the full map: the
        // reveal pins read in full-state context, and no zoom is ever
        // carried into the next round.
        if (RoundKey != _lastRoundKey)
        {
            _lastRoundKey = RoundKey;
            _viewport.Reset();
        }
        if (Revealed && !_lastRevealed)
        {
            _viewport.Reset();
        }
        _lastRevealed = Revealed;
    }

    private void ResetView()
    {
        _viewport.Reset();
    }

    private bool IsGuessInView()
    {
        if (GuessLatitude is null || GuessLongitude is null)
        {
            return false;
        }

        var (gx, gy) = MapProjection.LatLonToSvg(GuessLatitude.Value, GuessLongitude.Value);
        return _viewport.Contains(gx, gy);
    }

    private async Task OnPointerDown(PointerEventArgs e)
    {
        if (!Interactive || Revealed)
        {
            return;
        }

        // Measure the SVG's bounding rect when the first pointer goes
        // down (ClientX/Y are viewport-relative, so the rect is what
        // converts them to viewBox units). If the measurement fails,
        // ignore the gesture rather than placing a pin at a wrong place.
        if (_pointers.Count == 0)
        {
            try
            {
                var rect = await JS.InvokeAsync<double[]>("whereInTheState.svgRect", _svgRef);
                if (rect is not { Length: 4 } || rect[2] <= 0 || rect[3] <= 0)
                {
                    return;
                }
                _svgRect = rect;
            }
            catch
            {
                return;
            }
        }

        // Capture the pointer so moves keep arriving even if the finger
        // slides off the map mid-gesture.
        try
        {
            await JS.InvokeVoidAsync("whereInTheState.capturePointer", _svgRef, e.PointerId);
        }
        catch
        {
            // Pointer capture is best-effort; gestures still work without it.
        }

        _pointers[e.PointerId] = (e.ClientX, e.ClientY);

        if (_pointers.Count == 2)
        {
            // Second finger down: this gesture is a pinch. Anchor it at
            // the midpoint between the two pointers, in the current view.
            var pts = _pointers.Values.ToArray();
            double midClientX = (pts[0].ClientX + pts[1].ClientX) / 2;
            double midClientY = (pts[0].ClientY + pts[1].ClientY) / 2;
            _pinchStartDist = Math.Sqrt((pts[0].ClientX - pts[1].ClientX) * (pts[0].ClientX - pts[1].ClientX) + (pts[0].ClientY - pts[1].ClientY) * (pts[0].ClientY - pts[1].ClientY));
            _pinchStartWidth = _viewport.Width;
            (_pinchAnchorSvgX, _pinchAnchorSvgY) = _viewport.ClientToSvg(
                midClientX, midClientY, _svgRect![0], _svgRect[1], _svgRect[2], _svgRect[3]);
            _pinchAnchorClientX = midClientX;
            _pinchAnchorClientY = midClientY;
            _pinchGesture = true;
            return;
        }

        _downPos = (e.ClientX, e.ClientY);
        _downMoved = false;
        _panLast = (e.ClientX, e.ClientY);
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (!_pointers.TryGetValue(e.PointerId, out _) || _svgRect is null)
        {
            return;
        }

        _pointers[e.PointerId] = (e.ClientX, e.ClientY);

        if (_pointers.Count == 2 && _pinchGesture)
        {
            // Pinch: scale the viewBox by the change in finger distance,
            // keeping the pinch midpoint fixed on the map.
            var pts = _pointers.Values.ToArray();
            double dist = Math.Sqrt((pts[0].ClientX - pts[1].ClientX) * (pts[0].ClientX - pts[1].ClientX) + (pts[0].ClientY - pts[1].ClientY) * (pts[0].ClientY - pts[1].ClientY));
            if (dist > 0 && _pinchStartDist > 0)
            {
                _viewport.ZoomAt(_pinchAnchorSvgX, _pinchAnchorSvgY,
                    _pinchAnchorClientX, _pinchAnchorClientY,
                    _svgRect[0], _svgRect[1], _svgRect[2], _svgRect[3],
                    _pinchStartWidth * _pinchStartDist / dist);
                StateHasChanged();
            }
            return;
        }

        // One finger: mark movement past the tap threshold, and pan when
        // zoomed in. At full view a drag does nothing — the pin is placed
        // by a tap (pointerup), not by dragging.
        if (Math.Sqrt((e.ClientX - _downPos.ClientX) * (e.ClientX - _downPos.ClientX) + (e.ClientY - _downPos.ClientY) * (e.ClientY - _downPos.ClientY))
            > MapViewport.TapMoveThresholdPx)
        {
            _downMoved = true;
        }

        if (_pointers.Count == 1 && _viewport.IsZoomed)
        {
            _viewport.Pan(e.ClientX - _panLast.ClientX, e.ClientY - _panLast.ClientY,
                _svgRect[2], _svgRect[3]);
            StateHasChanged();
        }

        _panLast = (e.ClientX, e.ClientY);
    }

    private async Task OnPointerUp(PointerEventArgs e)
    {
        if (!_pointers.Remove(e.PointerId))
        {
            return;
        }

        if (_pointers.Count == 1)
        {
            // One finger lifted mid-pinch: the gesture stays a pinch (no
            // tap on release), but the remaining finger becomes a fresh
            // single pointer, so it can pan from here.
            var remaining = _pointers.Values.First();
            _downPos = (remaining.ClientX, remaining.ClientY);
            _downMoved = false;
            _panLast = (remaining.ClientX, remaining.ClientY);
            return;
        }

        // Gesture over. A tap — one pointer, no pinch, minimal movement —
        // places the pin, converted with the CURRENT viewBox (zoomed and
        // panned), via the same projection that drew the map.
        var rect = _svgRect;
        bool isTap = !_pinchGesture && !_downMoved && rect is not null;
        _pinchGesture = false;
        _svgRect = null;

        if (!isTap || !Interactive || Revealed)
        {
            return;
        }

        var (svgX, svgY) = _viewport.ClientToSvg(e.ClientX, e.ClientY,
            rect![0], rect[1], rect[2], rect[3]);
        var (latitude, longitude) = MapProjection.SvgToLatLon(svgX, svgY);
        await OnMapClicked.InvokeAsync((latitude, longitude));
    }

    private void OnPointerCancel(PointerEventArgs e)
    {
        _pointers.Remove(e.PointerId);
        if (_pointers.Count == 0)
        {
            _pinchGesture = false;
            _svgRect = null;
        }
    }

    private bool IsLayerVisible(string layer) => layer switch
    {
        "interstate" => ShowInterstates,
        "highway" => ShowHighways,
        "river" => ShowRivers,
        "lake" => ShowLakes,
        _ => true
    };

    private static string LandmarkCssClass(string layer) => layer switch
    {
        "interstate" => "map-interstate",
        "highway" => "map-highway",
        "river" => "map-river",
        _ => "map-landmark"
    };

    private static string PointsAttribute(IReadOnlyList<(double Lon, double Lat)> points)
    {
        // Project every point with the same function used for clicks.
        var parts = new string[points.Count];
        for (int i = 0; i < points.Count; i++)
        {
            var (x, y) = MapProjection.LatLonToSvg(points[i].Lat, points[i].Lon);
            parts[i] = $"{x:F1},{y:F1}";
        }

        return string.Join(" ", parts);
    }

    private MarkupString TrueLabel(double tx, double ty)
    {
        // Razor treats a literal <text> element as a text block, so the
        // reveal label is emitted as markup instead. The label is clamped
        // horizontally so long names don't run off the map, and flipped
        // below the pin when the pin is near the top edge.
        var labelX = Math.Clamp(tx, 70, 930);
        var labelY = ty < 50 ? ty + 34 : ty - 24;
        var name = System.Net.WebUtility.HtmlEncode(TrueName ?? "");
        return new MarkupString(
            $"<text x=\"{labelX:F1}\" y=\"{labelY:F1}\" class=\"map-label\">{name}</text>");
    }
}
