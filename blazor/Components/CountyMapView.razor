@using OregonGeographyGame.Models
@using OregonGeographyGame.Services
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="map-wrap">
<svg viewBox="@_viewport.ViewBox"
     class="map-svg"
     role="img"
     aria-label="Blank map of the state. No county lines are shown. Pinch to zoom."
     data-interactive="@(Interactive ? "true" : "false")"
     data-revealed="@(Revealed ? "true" : "false")"
     @ref="_svgRef">
    @* State outline *@
    @foreach (var feature in Outline)
    {
        @foreach (var ring in feature.Parts)
        {
            <polygon points="@PointsAttribute(ring)"
                     class="map-outline" />
        }
    }

    @* Landmarks, by layer (toggles are display-only; they never affect scoring) *@
    @foreach (var feature in Landmarks)
    {
        if (!IsLayerVisible(feature.Layer))
        {
            continue;
        }

        @foreach (var part in feature.Parts)
        {
            if (feature.Kind == "Polygon")
            {
                <polygon points="@PointsAttribute(part)"
                         class="map-lake" />
            }
            else
            {
                <polyline points="@PointsAttribute(part)"
                          fill="none"
                          class="@LandmarkCssClass(feature.Layer)" />
            }
        }
    }

    @* Reveal: the true county in green, so the player sees where it
       actually belongs. *@
    @if (Revealed && County is not null)
    {
        @foreach (var ring in _svgRings)
        {
            <polygon points="@SvgPointsAttribute(ring)"
                     class="county-true" />
        }
        @CountyLabel()
    }

    @* The draggable puzzle piece: the county's own shape at 1:1 scale,
       translated by (_dx, _dy). While placing it is rust and grabbable;
       on reveal it stays where the player dropped it, in red, next to
       the true county in green — where the two fills overlap, the colours
       blend, so the coverage reads at a glance. *@
    @if (County is not null && (Interactive || Revealed))
    {
        <g transform="translate(@_dx.ToString("F1") @_dy.ToString("F1"))"
           class="@(Revealed ? "" : "county-piece")"
           data-county-piece>
            @foreach (var ring in _svgRings)
            {
                <polygon points="@SvgPointsAttribute(ring)"
                         class="@(Revealed ? "county-placed" : "county-piece")" />
            }
        </g>
    }
</svg>

@* Reset view: only shown once zoomed in, so the player can always get
   back to the full map. Small and in the corner so it never pushes the
   game off one screen. *@
@if (_viewport.IsZoomed)
{
    <button type="button"
            class="map-reset-view"
            aria-label="Reset map view to the full state"
            @onclick="ResetView">Reset view</button>
}

@* A small Confirm bubble next to the piece once it has been dragged and
   dropped, so the player can confirm right where they placed it. It stays
   hidden while the piece is being dragged — it would chase the piece around
   the map — and only appears once the player stops moving it. (JS hides it
   during the drag with the .gesturing class on .map-wrap; .NET only learns
   a drag happened when the gesture ends.) Positioned in
   percentages of the map wrapper (exactly the SVG's box), via the current
   viewBox, so it tracks the piece at any zoom. Hidden while the piece's
   centre is outside the visible window. *@
@if (Interactive && !Revealed && County is not null && _hasDragged && IsPieceInView())
{
    var (cx, cy) = PieceCentroidSvg();
    var (leftPct, topPctRaw) = _viewport.ToPercent(cx, cy);
    var topPct = Math.Clamp(topPctRaw, 4, 96);
    var flipped = (cx - _viewport.X) > _viewport.Width * 0.75;
    <button type="button"
            class="pin-confirm@(flipped ? " flipped" : "")"
            style="left: @leftPct.ToString("F2")%; top: @topPct.ToString("F2")%;"
            aria-label="Confirm placement"
            @onclick="OnConfirmClicked">Confirm</button>
}
</div>

@code {
    [Parameter] public IReadOnlyList<MapFeature> Outline { get; set; } = [];
    [Parameter] public IReadOnlyList<MapFeature> Landmarks { get; set; } = [];

    [Parameter] public bool ShowInterstates { get; set; } = true;
    [Parameter] public bool ShowHighways { get; set; } = true;
    [Parameter] public bool ShowRivers { get; set; } = true;
    [Parameter] public bool ShowLakes { get; set; } = true;

    /// <summary>The county for this round (its shape is the puzzle piece).</summary>
    [Parameter] public MapFeature? County { get; set; }

    [Parameter] public bool Revealed { get; set; }
    [Parameter] public bool Interactive { get; set; } = true;

    /// <summary>
    /// A new round (from the parent's round index), so every round begins
    /// at the full view — a zoomed view is never carried across rounds.
    /// </summary>
    [Parameter] public int RoundKey { get; set; }

    /// <summary>Raised once, when the piece is first dragged this round.</summary>
    [Parameter] public EventCallback OnPieceDragged { get; set; }

    /// <summary>Raised when a drag ends, with the piece's translation in SVG units.</summary>
    [Parameter] public EventCallback<(double Dx, double Dy)> OnPieceDropped { get; set; }

    /// <summary>Raised when the player taps the Confirm bubble next to the piece.</summary>
    [Parameter] public EventCallback OnConfirmClicked { get; set; }

    private ElementReference _svgRef;

    // The visible window onto the map (pinch-to-zoom). The SVG's viewBox
    // is bound to it. This mode has pinch zoom only, no pan: one finger
    // always drags the piece, so a pan would fight the piece drag. The
    // live gesture is owned entirely by JS (mapGesture in index.html):
    // it writes the viewBox attribute directly during a pinch and moves
    // the piece by setting its transform directly, reporting the final
    // viewBox and piece position once, when the gesture ends (see
    // GestureEnded). .NET only ever holds the synced state — no .NET
    // state changes mid-gesture, so no re-render can snap the piece or
    // the viewBox back while the fingers move.
    private readonly MapViewport _viewport = new();

    // The .NET reference JS calls back into (GestureEnded), and whether
    // the SVG has rendered (JS attach/reset calls are skipped before it).
    private DotNetObjectReference<CountyMapView>? _mapGestureRef;
    private bool _hasRendered;

    private int _lastRoundKey = -1;
    private bool _lastRevealed;

    // The county's rings in SVG coordinates (cached per round), and the
    // piece's translation in SVG units. The piece is the true county
    // translated by (_dx, _dy); at the true location _dx == _dy == 0.
    private List<IReadOnlyList<(double X, double Y)>> _svgRings = [];
    private double _dx;
    private double _dy;
    private string? _currentCountyName;

    // Whether the piece has been dragged this round (enables the Confirm
    // bubble) and whether the parent has been told (OnPieceDragged fires
    // once, when the first drag ends — see GestureEnded).
    private bool _hasDragged;
    private bool _dragNotified;

    /// <summary>The piece's current translation in SVG units (for scoring).</summary>
    public double PieceDx => _dx;

    /// <summary>The piece's current translation in SVG units (for scoring).</summary>
    public double PieceDy => _dy;

    protected override void OnParametersSet()
    {
        // A new round, or the reveal, returns to the full map: the
        // reveal counties read in full-state context, and no zoom is ever
        // carried into the next round.
        if (RoundKey != _lastRoundKey)
        {
            _lastRoundKey = RoundKey;
            ResetViewport();
        }
        if (Revealed && !_lastRevealed)
        {
            ResetViewport();
        }
        _lastRevealed = Revealed;

        // Reset the piece to its staging position only when the round's
        // county changes — not on every re-render, or a drag would be
        // undone by the parent re-rendering.
        var name = County?.Name;
        if (name is not null && name != _currentCountyName)
        {
            _currentCountyName = name;
            _svgRings = ProjectRings(County!.Parts);
            (_dx, _dy) = StagingTranslation();
            _hasDragged = false;
            _dragNotified = false;
            _viewport.Reset();
        }
    }

    private void ResetView()
    {
        ResetViewport();
    }

    /// <summary>
    /// Reset the window to the full map, in .NET and in JS: the JS
    /// controller's easing loop is cancelled and its viewport returns
    /// to full, so a reset can never be overwritten by a frame still
    /// in flight. The Razor viewBox binding writes the full view on
    /// the next render, so the two agree.
    /// </summary>
    private void ResetViewport()
    {
        _viewport.Reset();
        if (_hasRendered)
        {
            _ = JS.InvokeVoidAsync("whereInTheState.mapGestureReset", _svgRef);
        }
    }

    protected override void OnInitialized()
    {
        _mapGestureRef = DotNetObjectReference.Create(this);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _hasRendered = true;
            _ = JS.InvokeVoidAsync("whereInTheState.mapGestureAttach", _svgRef, _mapGestureRef, "counties");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hasRendered)
        {
            try
            {
                await JS.InvokeVoidAsync("whereInTheState.mapGestureDetach", _svgRef);
            }
            catch
            {
                // Best-effort: the element is going away anyway.
            }
        }
        _mapGestureRef?.Dispose();
    }

    /// <summary>
    /// Called by the JS gesture controller exactly once, when a gesture
    /// ends, with the final viewBox — and a piece drop, if the gesture
    /// moved the piece (by drop, or cancelled by a pinch). This is the
    /// only moment .NET learns about a gesture, so there is no re-render
    /// or interop while the fingers are moving. A drag is first reported
    /// here (not at drag start), so the Confirm button and hint update
    /// when the piece stops — and no mid-drag re-render can snap the
    /// piece back to its pre-drag position.
    /// </summary>
    [JSInvokable]
    public async Task GestureEnded(double x, double y, double width, double height,
        double? tapSvgX, double? tapSvgY, double? pieceDx, double? pieceDy)
    {
        _viewport.SyncTo(x, y, width);
        if (pieceDx.HasValue && pieceDy.HasValue)
        {
            _dx = pieceDx.Value;
            _dy = pieceDy.Value;
            if (!_dragNotified)
            {
                _dragNotified = true;
                _hasDragged = true;
                await OnPieceDragged.InvokeAsync();
            }
            await OnPieceDropped.InvokeAsync((_dx, _dy));
        }
        StateHasChanged();
    }

    private bool IsPieceInView()
    {
        var (cx, cy) = PieceCentroidSvg();
        return _viewport.Contains(cx, cy);
    }

    /// <summary>
    /// The staging position: the piece's bounding-box top-left at (10, 10)
    /// in SVG units — up in the top-left corner, outside the state outline,
    /// clearly a piece waiting to be placed rather than an answer.
    /// </summary>
    private (double Dx, double Dy) StagingTranslation()
    {
        double minX = double.MaxValue, minY = double.MaxValue;
        foreach (var ring in _svgRings)
        {
            foreach (var (x, y) in ring)
            {
                minX = Math.Min(minX, x);
                minY = Math.Min(minY, y);
            }
        }

        return (10 - minX, 10 - minY);
    }

    private static List<IReadOnlyList<(double X, double Y)>> ProjectRings(
        IReadOnlyList<IReadOnlyList<(double Lon, double Lat)>> parts)
    {
        var result = new List<IReadOnlyList<(double X, double Y)>>();
        foreach (var ring in parts)
        {
            var projected = new List<(double X, double Y)>(ring.Count);
            foreach (var (lon, lat) in ring)
            {
                projected.Add(MapProjection.LatLonToSvg(lat, lon));
            }
            result.Add(projected);
        }

        return result;
    }

    private (double X, double Y) PieceCentroidSvg()
    {
        double minX = double.MaxValue, minY = double.MaxValue;
        double maxX = double.MinValue, maxY = double.MinValue;
        foreach (var ring in _svgRings)
        {
            foreach (var (x, y) in ring)
            {
                minX = Math.Min(minX, x); maxX = Math.Max(maxX, x);
                minY = Math.Min(minY, y); maxY = Math.Max(maxY, y);
            }
        }

        return ((minX + maxX) / 2 + _dx, (minY + maxY) / 2 + _dy);
    }

    private bool IsLayerVisible(string layer) => layer switch
    {
        "interstate" => ShowInterstates,
        "highway" => ShowHighways,
        "river" => ShowRivers,
        "lake" => ShowLakes,
        _ => true
    };

    private static string LandmarkCssClass(string layer) => layer switch
    {
        "interstate" => "map-interstate",
        "highway" => "map-highway",
        "river" => "map-river",
        _ => "map-landmark"
    };

    private static string PointsAttribute(IReadOnlyList<(double Lon, double Lat)> points)
    {
        var parts = new string[points.Count];
        for (int i = 0; i < points.Count; i++)
        {
            var (x, y) = MapProjection.LatLonToSvg(points[i].Lat, points[i].Lon);
            parts[i] = $"{x:F1},{y:F1}";
        }

        return string.Join(" ", parts);
    }

    private static string SvgPointsAttribute(IReadOnlyList<(double X, double Y)> points)
    {
        var parts = new string[points.Count];
        for (int i = 0; i < points.Count; i++)
        {
            parts[i] = $"{points[i].X:F1},{points[i].Y:F1}";
        }

        return string.Join(" ", parts);
    }

    private MarkupString CountyLabel()
    {
        // The county name on the true county, like the city name label on
        // the reveal pin. Centred on the true county's bounding box,
        // clamped so long names don't run off the map.
        double minX = double.MaxValue, minY = double.MaxValue;
        double maxX = double.MinValue, maxY = double.MinValue;
        foreach (var ring in _svgRings)
        {
            foreach (var (x, y) in ring)
            {
                minX = Math.Min(minX, x); maxX = Math.Max(maxX, x);
                minY = Math.Min(minY, y); maxY = Math.Max(maxY, y);
            }
        }

        var labelX = Math.Clamp((minX + maxX) / 2, 90, 910);
        var labelY = Math.Clamp((minY + maxY) / 2, 30, 730);
        var name = System.Net.WebUtility.HtmlEncode(County?.Name ?? "");
        return new MarkupString(
            $"<text x=\"{labelX:F1}\" y=\"{labelY:F1}\" class=\"map-label\">{name}</text>");
    }
}
