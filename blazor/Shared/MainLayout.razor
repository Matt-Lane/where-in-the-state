@inherits LayoutComponentBase
@implements IDisposable
@inject HeaderTitleService HeaderTitle

<div class="page">
    <header class="site-header">
        <p class="wordmark"><svg class="wordmark-logo" viewBox="0 0 96 96" aria-hidden="true"><path class="pin-fill" d="M48 8 C32.5 8 20 20.5 20 34 C20 55 48 86 48 86 C48 86 76 55 76 34 C76 20.5 63.5 8 48 8 Z" /><text class="mark-fill" x="48" y="46" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" font-weight="700" font-size="34">?!</text></svg>@HeaderTitle.Title</p>
    </header>
    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
    <footer class="site-footer">
        A geography game for Oregon — 241 cities, one blank map, 10 questions per game.
        <span class="version">Version 0.19</span>
    </footer>
</div>

@code {
    protected override void OnInitialized()
    {
        HeaderTitle.TitleChanged += OnTitleChanged;
    }

    private void OnTitleChanged() => StateHasChanged();

    public void Dispose()
    {
        HeaderTitle.TitleChanged -= OnTitleChanged;
    }
}
