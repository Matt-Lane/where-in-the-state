@inherits LayoutComponentBase
@implements IDisposable
@inject HeaderTitleService HeaderTitle

<div class="page">
    <header class="site-header">
        <p class="wordmark"><span class="wordmark-dot" aria-hidden="true"></span>@HeaderTitle.Title</p>
    </header>
    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
    <footer class="site-footer">
        A geography game for Oregon — 241 cities, one blank map, 10 questions per game.
        <span class="version">Version 0.14</span>
    </footer>
</div>

@code {
    protected override void OnInitialized()
    {
        HeaderTitle.TitleChanged += OnTitleChanged;
    }

    private void OnTitleChanged() => StateHasChanged();

    public void Dispose()
    {
        HeaderTitle.TitleChanged -= OnTitleChanged;
    }
}
