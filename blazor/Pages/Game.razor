@page "/{StateId}"
@page "/{StateId}/{ModeParam}"
@page "/{StateId}/{ModeParam}/{SeedParam}"
@using OregonGeographyGame.Models
@using OregonGeographyGame.Services
@inject StatePackLoader PackLoader
@inject SeededGameService GameService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HeaderTitleService HeaderTitle

<PageTitle>@PageTitleText</PageTitle>

@* The edition badge: centred on the header's bottom border, at the
   top of the game page content, so the player knows which edition
   they are playing before they start — on the start screen and
   during play. The wrapper pulls it up to the border and the badge's
   own translateY(-50%) centres it on that edge, so the line reads
   as a stick through the badge (a corndog). Only for the Risk Pool
   edition (the default); the All edition shows no badge. Not shown
   on the not-found screen or before the pack loads. *@
@if (_pack is not null && _edition == Edition.RiskPool && _pack.RiskPool is not null)
{
    <div class="edition-badge-wrap">
        <p class="edition-badge">Risk Pool Edition</p>
    </div>
}

@if (_loadFailed)
{
    <div class="card error-card">
    <h1>Where in the State</h1>
    <p role="alert">We couldn't find a state called <strong>@_stateId</strong>.</p>
    <p>Check the link and try again, or start over with Oregon.</p>
    <div class="button-row">
        <button class="primary" @onclick="PlayOregon">Play Oregon</button>
    </div>
    </div>
}
else if (_pack is null)
{
    <p>Loading the map…</p>
}
else if (_phase == Phase.Start)
{
    @* The start screen is reached at /{state} and below, so the URL
       always named the state and the header already says
       "Where in the {StateName}?!". The per-mode instructions (lede +
       steps) live in the card under the mode picker, not here. *@

    <div class="card">
        <div class="mode-picker">
            <p class="field-label" id="mode-label">Game mode</p>
            @* One big preview image of the selected mode, with three small
               buttons underneath to change it. All four previews are stacked
               in one grid cell and only the selected mode's is visible, so
               the big image is always the same size and switching modes
               never moves the Play button below it. The Counties drag mode
               is hidden from the picker (its code and /oregon/counties/
               route still work) — only City County Mode, Cities and Name
               the county are offered here. *@
            <div class="mode-preview-big" aria-hidden="true">
                @* City County Mode preview: one image split diagonally
                   from the top left to the bottom right. The lower-left
                   triangle is the county half (county boundaries with
                   Douglas County filled green); the upper-right triangle
                   is the city half (a La Grande reveal: guess pin, dotted
                   line, actual marker). Each half is clipped to its
                   triangle; a white line marks the cut. *@
                <svg class="mode-preview@(_mode == GameMode.CityCounty ? " is-active" : "")" viewBox="0 0 1000 757.4" aria-hidden="true">
                    <defs>
                        <clipPath id="preview-split-county">
                            <polygon points="0,0 0,757.4 1000,757.4" />
                        </clipPath>
                        <clipPath id="preview-split-city">
                            <polygon points="0,0 1000,0 1000,757.4" />
                        </clipPath>
                    </defs>
                    <path d="@ModePreviewArt.OutlinePath" class="preview-state" />
                    <g clip-path="url(#preview-split-county)">
                        <path d="@ModePreviewArt.CountyGridPath" class="preview-grid" />
                        <path d="@ModePreviewArt.DouglasPath" class="preview-county-pick" />
                    </g>
                    <g clip-path="url(#preview-split-city)">
                        <line x1="@ModePreviewArt.SplitGuessX" y1="@ModePreviewArt.SplitGuessY" x2="@ModePreviewArt.LaGrandeX" y2="@ModePreviewArt.LaGrandeY" class="preview-line" />
                        <circle cx="@ModePreviewArt.SplitGuessX" cy="@ModePreviewArt.SplitGuessY" r="16" class="preview-guess" />
                        <circle cx="@ModePreviewArt.SplitGuessX" cy="@ModePreviewArt.SplitGuessY" r="6" class="preview-guess-dot" />
                        <circle cx="@ModePreviewArt.LaGrandeX" cy="@ModePreviewArt.LaGrandeY" r="14" class="preview-target" />
                        <circle cx="@ModePreviewArt.LaGrandeX" cy="@ModePreviewArt.LaGrandeY" r="5" class="preview-target-dot" />
                    </g>
                    <line x1="0" y1="0" x2="1000" y2="757.4" class="preview-split-line" />
                </svg>
                <svg class="mode-preview@(_mode == GameMode.Cities ? " is-active" : "")" viewBox="0 0 1000 757.4" aria-hidden="true">
                    <path d="@ModePreviewArt.OutlinePath" class="preview-state" />
                    <line x1="@ModePreviewArt.GuessX" y1="@ModePreviewArt.GuessY" x2="@ModePreviewArt.BendX" y2="@ModePreviewArt.BendY" class="preview-line" />
                    <circle cx="@ModePreviewArt.GuessX" cy="@ModePreviewArt.GuessY" r="16" class="preview-guess" />
                    <circle cx="@ModePreviewArt.GuessX" cy="@ModePreviewArt.GuessY" r="6" class="preview-guess-dot" />
                    <circle cx="@ModePreviewArt.BendX" cy="@ModePreviewArt.BendY" r="14" class="preview-target" />
                    <circle cx="@ModePreviewArt.BendX" cy="@ModePreviewArt.BendY" r="5" class="preview-target-dot" />
                </svg>
                <svg class="mode-preview@(_mode == GameMode.Counties ? " is-active" : "")" viewBox="0 0 1000 757.4" aria-hidden="true">
                    <defs>
                        <marker id="preview-arrowhead" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                            <path d="M0,0 L10,5 L0,10 z" class="preview-arrowhead" />
                        </marker>
                    </defs>
                    <path d="@ModePreviewArt.OutlinePath" class="preview-state" />
                    <path d="@ModePreviewArt.DeschutesPath" class="preview-ghost" />
                    <path d="@ModePreviewArt.DeschutesPath" transform="@ModePreviewArt.PieceTransform" class="preview-piece" />
                    <path d="M400,315 Q395,355 375,385" class="preview-arrow" marker-end="url(#preview-arrowhead)" />
                </svg>
                <svg class="mode-preview@(_mode == GameMode.NameTheCounty ? " is-active" : "")" viewBox="0 0 1000 757.4" aria-hidden="true">
                    <path d="@ModePreviewArt.OutlinePath" class="preview-state" />
                    <path d="@ModePreviewArt.CountyGridPath" class="preview-grid" />
                    <path d="@ModePreviewArt.DeschutesPath" class="preview-selected" />
                </svg>
            </div>
            <div class="mode-switch-row" role="group" aria-labelledby="mode-label">
                <button type="button" class="mode-switch" aria-pressed="@(_mode == GameMode.CityCounty ? "true" : "false")" disabled="@(_pack.Counties.Count == 0)" @onclick="() => _mode = GameMode.CityCounty">City/County</button>
                <button type="button" class="mode-switch" aria-pressed="@(_mode == GameMode.Cities ? "true" : "false")" @onclick="() => _mode = GameMode.Cities">City</button>
                <button type="button" class="mode-switch" aria-pressed="@(_mode == GameMode.NameTheCounty ? "true" : "false")" disabled="@(_pack.Counties.Count == 0)" @onclick="() => _mode = GameMode.NameTheCounty">County</button>
            </div>
        </div>

        @* The main Play button: it starts a game with whatever Game # is
           in the box below. The label is dynamic — "Play Today's Game"
           when the box holds today's Game #, just "Play" for any other
           Game # (or an empty box, when it is disabled). *@
        <button class="primary play-today" @onclick="StartGame" disabled="@string.IsNullOrWhiteSpace(_seed)">
            @(IsDailySeed ? "Play Today's Game" : "Play")
        </button>

        @* Game # box: stays visible below Play, for joining a shared game.
           It is pre-filled with today's Game # on load (or the Game # from
           a shared link). The box is sized for the daily Game # (~10
           characters); the calendar button restores today's Game # and the
           dice button fills in a random one. Both are icon-only. *@
        <div class="seed-row">
            <label>
                Game #
                <input type="text" class="seed-input" @bind="_seed" @bind:event="oninput" maxlength="20" size="11" />
            </label>
            <button type="button" class="icon-btn" @onclick="UseDailySeed" aria-label="Use today's game number">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2" /><line x1="3" y1="10" x2="21" y2="10" stroke="currentColor" stroke-width="2" /><line x1="8" y1="3" x2="8" y2="7" stroke="currentColor" stroke-width="2" /><line x1="16" y1="3" x2="16" y2="7" stroke="currentColor" stroke-width="2" /></svg>
            </button>
            <button type="button" class="icon-btn" @onclick="UseRandomSeed" aria-label="Random game number">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="8" cy="8" r="1.8" fill="currentColor" /><circle cx="16" cy="8" r="1.8" fill="currentColor" /><circle cx="12" cy="12" r="1.8" fill="currentColor" /><circle cx="8" cy="16" r="1.8" fill="currentColor" /><circle cx="16" cy="16" r="1.8" fill="currentColor" /></svg>
            </button>
        </div>
        <p class="hint">Same Game # = same @SeedPoolLabel, same order. Share it to play the same game as another player.</p>

        @* How to play: the instructions for the selected mode, collapsed
           behind a button (minimized by default). The four variants are
           still stacked in one grid cell, so switching modes while it is
           open never moves anything below it. *@
        <div class="start-section">
            <button type="button" class="section-toggle" aria-expanded="@(_showHowToPlay ? "true" : "false")" aria-controls="how-to-play" @onclick="() => _showHowToPlay = !_showHowToPlay">
                @(_showHowToPlay ? "▾" : "▸") How to play
            </button>
            @if (_showHowToPlay)
            {
            <div class="mode-instructions">
                <div class="mode-instructions-set@(_mode == GameMode.CityCounty ? " is-active" : "")" aria-hidden="@(_mode == GameMode.CityCounty ? "false" : "true")">
                    <p class="lede">
                        A mix of both: <strong>7 city rounds and 3 county rounds</strong>,
                        shuffled together. City rounds: drop a pin where you think the
                        city is. County rounds: click the county on the map. 100 points
                        per question — full points for a pin within 5 miles, 100 for
                        naming the right county, 50 for a county that touches it. <strong>10 questions</strong> per game.
                    </p>
                    <ol class="how-it-works">
                        <li><strong><span class="step-num">1</span>Pick a Game #</strong>Same Game #, same 7 cities and 3 counties — share it to play together.</li>
                        <li><strong><span class="step-num">2</span>Drop a pin or pick the county</strong>City rounds: tap the map where you think the city is. County rounds: click the county that matches the name.</li>
                        <li><strong><span class="step-num">3</span>See how close</strong>The real spot or county is revealed, with your distance or pick and your points.</li>
                    </ol>
                </div>
                <div class="mode-instructions-set@(_mode == GameMode.Cities ? " is-active" : "")" aria-hidden="@(_mode == GameMode.Cities ? "false" : "true")">
                    <p class="lede">
                        A blank map of <strong>@_pack.Name</strong> — outline and landmarks,
                        but no city names. Each round names one city; click or tap the map where
                        you think it is. 100 points for a guess within 5 miles, then −1 point per
                        mile beyond 5, floored at 0. <strong>10 questions</strong> per game.
                    </p>
                    <ol class="how-it-works">
                        <li><strong><span class="step-num">1</span>Pick a Game #</strong>Same Game #, same 10 cities — share it to play together.</li>
                        <li><strong><span class="step-num">2</span>Drop a pin</strong>Tap the map where you think the city is, then confirm.</li>
                        <li><strong><span class="step-num">3</span>See how close</strong>The real spot is revealed, with your distance and points.</li>
                    </ol>
                </div>
                <div class="mode-instructions-set@(_mode == GameMode.Counties ? " is-active" : "")" aria-hidden="@(_mode == GameMode.Counties ? "false" : "true")">
                    <p class="lede">
                        A blank map of <strong>@_pack.Name</strong> — outline and landmarks,
                        but no county lines. Each round names one county; drag its shape onto
                        the map where you think it belongs. 100 points for a perfect fit,
                        scaled by how much of the real county you cover.
                        <strong>10 questions</strong> per game.
                    </p>
                    <ol class="how-it-works">
                        <li><strong><span class="step-num">1</span>Pick a Game #</strong>Same Game #, same 10 counties — share it to play together.</li>
                        <li><strong><span class="step-num">2</span>Drag the piece</strong>Drag the county's shape onto the map where it belongs, then confirm.</li>
                        <li><strong><span class="step-num">3</span>See the overlap</strong>The real county is revealed, with how much of it you covered and your points.</li>
                    </ol>
                </div>
                <div class="mode-instructions-set@(_mode == GameMode.NameTheCounty ? " is-active" : "")" aria-hidden="@(_mode == GameMode.NameTheCounty ? "false" : "true")">
                    <p class="lede">
                        A map of <strong>@_pack.Name</strong> with every county outlined,
                        but no county names. Each round names one county; click the county
                        you think it is. 100 points for naming the right county, 50 for a
                        county that touches it, 0 for any other. <strong>10 questions</strong> per game.
                    </p>
                    <ol class="how-it-works">
                        <li><strong><span class="step-num">1</span>Pick a Game #</strong>Same Game #, same 10 counties — share it to play together.</li>
                        <li><strong><span class="step-num">2</span>Pick the county</strong>Click the county on the map that matches the name, then confirm.</li>
                        <li><strong><span class="step-num">3</span>See if you were right</strong>The real county is revealed, with what you picked and your points.</li>
                    </ol>
                </div>
            </div>
            }
        </div>

        @* Advanced options: the landmark toggles, collapsed by default. *@
        <div class="start-section">
            <button type="button" class="section-toggle" aria-expanded="@(_showAdvanced ? "true" : "false")" aria-controls="advanced-options" @onclick="() => _showAdvanced = !_showAdvanced">
                @(_showAdvanced ? "▾" : "▸") Advanced options
            </button>
            @if (_showAdvanced)
            {
            <fieldset>
                <legend>Landmarks (display only — they don't affect scoring)</legend>
                <div class="toggle-row" role="group" aria-label="Map layers">
                    <button type="button" class="toggle" data-layer="interstate" aria-pressed="@(_showInterstates ? "true" : "false")" @onclick="() => _showInterstates = !_showInterstates"><span class="swatch"></span>Interstates</button>
                    <button type="button" class="toggle" data-layer="highway" aria-pressed="@(_showHighways ? "true" : "false")" @onclick="() => _showHighways = !_showHighways"><span class="swatch"></span>Highways</button>
                    <button type="button" class="toggle" data-layer="river" aria-pressed="@(_showRivers ? "true" : "false")" @onclick="() => _showRivers = !_showRivers"><span class="swatch"></span>Rivers</button>
                    <button type="button" class="toggle" data-layer="lake" aria-pressed="@(_showLakes ? "true" : "false")" @onclick="() => _showLakes = !_showLakes"><span class="swatch fill"></span>Lakes</button>
                </div>
            </fieldset>
            @if (_pack.RiskPool is not null)
            {
            @* Which cities and counties the game draws from. Only offered
               when the pack has a risk pool; a pack without one plays the
               full list and has no Risk Pool edition. The default is Risk
               Pool. Changing it updates the badge above and the pool the
               next game draws from. *@
            <fieldset>
                <legend>City &amp; County List</legend>
                <div class="mode-switch-row" role="group" aria-label="City and county list">
                    <button type="button" class="mode-switch" aria-pressed="@(_edition == Edition.RiskPool ? "true" : "false")" @onclick="() => _edition = Edition.RiskPool">Risk Pool</button>
                    <button type="button" class="mode-switch" aria-pressed="@(_edition == Edition.All ? "true" : "false")" @onclick="() => _edition = Edition.All">All</button>
                </div>
                <p class="hint">Risk Pool limits the game to the risk pool's @_pack.RiskPool.Cities.Count cities and @_pack.RiskPool.Counties.Count counties. All uses the full list of @_pack.Cities.Count cities and @_pack.Counties.Count counties.</p>
            </fieldset>
            }
            }
        </div>
    </div>
}
else if (_phase == Phase.Round || _phase == Phase.Reveal)
{
    var isCounties = _mode == GameMode.Counties;
    var isNameTheCounty = _mode == GameMode.NameTheCounty;
    var isCityCounty = _mode == GameMode.CityCounty;
    // In City County Mode the round type comes from the shuffled mixed
    // rounds: a county round uses the NameTheCounty UI, a city round the
    // Cities UI.
    var mixedRound = isCityCounty ? _mixedRounds[_roundIndex] : null;
    var isMixedCounty = mixedRound?.IsCounty == true;
    var totalRounds = isCityCounty ? _mixedRounds.Count : isCounties || isNameTheCounty ? _gameCounties.Count : _gameCities.Count;
    <div class="round-status">
        <div class="progress-wrap">
            <div class="progress-track" role="progressbar" aria-valuenow="@_totalScore" aria-valuemin="0" aria-valuemax="@MaxScore" aria-label="Score out of @MaxScore" aria-valuetext="@($"{_totalScore} out of {MaxScore}; maximum {(_roundIndex + 1) * PointsPerRound} after question {_roundIndex + 1}")">
                <div class="progress-fill" style="width: @(_totalScore * 100 / MaxScore)%"></div>
            </div>
            <div class="progress-max" style="left: @((_roundIndex + 1) * 10)%" title="Maximum possible after question @(_roundIndex + 1): @((_roundIndex + 1) * PointsPerRound)" aria-hidden="true"></div>
        </div>
        <p class="score-chip">Score: <strong>@_totalScore</strong> / @MaxScore</p>
    </div>
    @if (isNameTheCounty || isMixedCounty)
    {
        var county = isMixedCounty ? mixedRound!.County! : _gameCounties[_roundIndex];
        <h1 class="question">Question @(_roundIndex + 1) of @totalRounds — Where is <strong>@county.Name</strong>?</h1>
        <p class="sr-only">Question @(_roundIndex + 1) of @totalRounds: Where is @county.Name?</p>

        <div class="map-card">
        <div class="game-controls">
            @if (_phase == Phase.Round)
            {
                <div class="controls-row">
                    <button class="primary" @onclick="ConfirmGuess" disabled="@(_selectedCounty is null)">
                        Confirm guess
                    </button>
                    <button @onclick="Pass">Pass (0 points)</button>
                </div>
                <p class="controls-hint">
                    @(_selectedCounty is null
                        ? "Click a county on the map to select it."
                        : "County selected — click another county to change it, or confirm.")
                </p>
            }
            else
            {
                // The county rounds of both modes share this reveal: the
                // correct county is 100 points, a county sharing a border
                // with it is 50 ("Pretty close!"), any other pick is 0.
                var mixedResult = isMixedCounty ? _mixedResults[_roundIndex] : null;
                var selectedName = isMixedCounty ? mixedResult!.SelectedCountyName : _nameResults[_roundIndex].SelectedCountyName;
                var isCorrect = isMixedCounty ? mixedResult!.IsCorrect == true : _nameResults[_roundIndex].IsCorrect;
                var isAdjacent = isMixedCounty ? mixedResult!.IsAdjacent : _nameResults[_roundIndex].IsAdjacent;
                <div class="controls-row">
                    <button class="primary" @onclick="NextRound">
                        @(_roundIndex + 1 >= totalRounds ? "See results" : isCityCounty ? "Next question" : "Next county")
                    </button>
                </div>
                <p class="reveal-line">
                    @if (selectedName is null)
                    {
                        <text>You passed — the green county is @county.Name.</text>
                    }
                    else if (isCorrect)
                    {
                        <text>Correct — that's @county.Name · 100 points</text>
                    }
                    else if (isAdjacent)
                    {
                        <text>Pretty close! That's @selectedName, not @county.Name · 50 points</text>
                    }
                    else
                    {
                        <text>That's @selectedName, not @county.Name · 0 points</text>
                    }
                </p>
            }
        </div>

        <NameTheCountyMapView Outline="@_pack.Outline"
                 Landmarks="@_pack.Landmarks"
                 ShowInterstates="@_showInterstates"
                 ShowHighways="@_showHighways"
                 ShowRivers="@_showRivers"
                 ShowLakes="@_showLakes"
                 Counties="@_pack.Counties"
                 SelectedCounty="@_selectedCounty"
                 TrueCounty="@(_phase == Phase.Reveal ? county : null)"
                 Revealed="@(_phase == Phase.Reveal)"
                 Interactive="@(_phase == Phase.Round)"
                 RoundKey="@_roundIndex"
                 OnCountySelected="OnCountySelected"
                 OnConfirmClicked="ConfirmGuess" />
        </div>
    }
    else if (isCounties)
    {
        var county = _gameCounties[_roundIndex];
        <h1 class="question">Question @(_roundIndex + 1) of @totalRounds — Where is <strong>@county.Name</strong>?</h1>
        <p class="sr-only">Question @(_roundIndex + 1) of @totalRounds: Where is @county.Name?</p>

        <div class="map-card">
        <div class="game-controls">
            @if (_phase == Phase.Round)
            {
                <div class="controls-row">
                    <button class="primary" @onclick="ConfirmGuess" disabled="@(!_countyDragged)">
                        Confirm guess
                    </button>
                    <button @onclick="Pass">Pass (0 points)</button>
                </div>
                <p class="controls-hint">
                    @(_countyDragged
                        ? "Piece placed — drag it again to move it, or confirm."
                        : "Drag the county piece onto the map.")
                </p>
            }
            else
            {
                var result = _countyResults[_roundIndex];
                <div class="controls-row">
                    <button class="primary" @onclick="NextRound">
                        @(_roundIndex + 1 >= totalRounds ? "See results" : "Next county")
                    </button>
                </div>
                <p class="reveal-line">
                    @if (result.OverlapFraction is null)
                    {
                        <text>You passed — the green shape is @county.Name.</text>
                    }
                    else
                    {
                        <text>You covered @((result.OverlapFraction.Value * 100).ToString("F0"))% of @county.Name · @result.Points points</text>
                    }
                </p>
            }
        </div>

        <CountyMapView Outline="@_pack.Outline"
                 Landmarks="@_pack.Landmarks"
                 ShowInterstates="@_showInterstates"
                 ShowHighways="@_showHighways"
                 ShowRivers="@_showRivers"
                 ShowLakes="@_showLakes"
                 County="@county"
                 Revealed="@(_phase == Phase.Reveal)"
                 Interactive="@(_phase == Phase.Round)"
                 RoundKey="@_roundIndex"
                 OnPieceDragged="OnPieceDragged"
                 OnPieceDropped="OnPieceDropped"
                 OnConfirmClicked="ConfirmGuess" />
        </div>
    }
    else
    {
        var city = isCityCounty ? mixedRound!.City! : _gameCities[_roundIndex];
        <h1 class="question">Question @(_roundIndex + 1) of @totalRounds — Where is <strong>@city.Name</strong>?</h1>
        <p class="sr-only">Question @(_roundIndex + 1) of @totalRounds: Where is @city.Name?</p>

        <div class="map-card">
        <div class="game-controls">
            @if (_phase == Phase.Round)
            {
                <div class="controls-row">
                    <button class="primary" @onclick="ConfirmGuess" disabled="@(_guessLat is null)">
                        Confirm guess
                    </button>
                    <button @onclick="Pass">Pass (0 points)</button>
                </div>
                <p class="controls-hint">
                    @(_guessLat is null
                        ? "Click or tap the map to place your pin."
                        : "Pin placed — click again to move it, or confirm.")
                </p>
            }
            else
            {
                var mixedResult = isCityCounty ? _mixedResults[_roundIndex] : null;
                var distance = isCityCounty ? mixedResult!.DistanceMiles : _results[_roundIndex].DistanceMiles;
                var points = isCityCounty ? mixedResult!.Points : _results[_roundIndex].Points;
                <div class="controls-row">
                    <button class="primary" @onclick="NextRound">
                        @(_roundIndex + 1 >= totalRounds ? "See results" : isCityCounty ? "Next question" : "Next city")
                    </button>
                </div>
                <p class="reveal-line">
                    @if (distance is null)
                    {
                        <text>You passed — the green pin is @city.Name.</text>
                    }
                    else
                    {
                        <text>@distance.Value.ToString("F1") mi off · @points points</text>
                    }
                </p>
            }
        </div>

        <MapView Outline="@_pack.Outline"
                 Landmarks="@_pack.Landmarks"
                 ShowInterstates="@_showInterstates"
                 ShowHighways="@_showHighways"
                 ShowRivers="@_showRivers"
                 ShowLakes="@_showLakes"
                 GuessLatitude="@_guessLat"
                 GuessLongitude="@_guessLon"
                 TrueLatitude="@(_phase == Phase.Reveal ? city.Latitude : null)"
                 TrueLongitude="@(_phase == Phase.Reveal ? city.Longitude : null)"
                 TrueName="@(_phase == Phase.Reveal ? city.Name : null)"
                 Revealed="@(_phase == Phase.Reveal)"
                 Interactive="@(_phase == Phase.Round)"
                 RoundKey="@_roundIndex"
                 OnMapClicked="OnMapClicked"
                 OnConfirmClicked="ConfirmGuess" />
        </div>
    }
}
else if (_phase == Phase.Results)
{
    <div class="results-hero">
        <p class="eyebrow">Your results</p>
        <h1><span class="score-big">@_totalScore</span> <span class="score-of">/ @MaxScore</span></h1>
        <div class="score-bar-track" role="progressbar" aria-valuenow="@_totalScore" aria-valuemin="0" aria-valuemax="@MaxScore" aria-label="Score out of @MaxScore">
            <div class="score-bar-fill" style="width: @(_totalScore * 100 / MaxScore)%"></div>
        </div>
        <div class="summary-row">
            <div class="summary-box">
                <p>I scored @_totalScore/@MaxScore on Where in the @(_pack?.Name ?? "Oregon")?!@ModeSummaryLabel, Game # @_seed</p>
                <p>@EditionSummaryLabel</p>
                <p>Play the same game: <a href="@GameLink">@GameLink</a></p>
            </div>
            <button @onclick="CopySummary">Copy</button>
        </div>
        @* Always rendered: visibility toggles, so showing the "Copied"
           note never moves anything on the screen. The non-breaking
           space keeps the line's height when there is no message. *@
        <p class="copy-status" role="status" style="visibility: @(_copyMessage is null ? "hidden" : "visible")">@(_copyMessage ?? "\u00a0")</p>
    </div>

    <table class="results-table">
        <thead>
            <tr><th>#</th><th>@(_mode == GameMode.CityCounty ? "Target" : _mode == GameMode.Cities ? "City" : "County")</th><th>@(_mode == GameMode.CityCounty ? "Answer" : _mode == GameMode.Cities ? "Distance" : _mode == GameMode.Counties ? "Coverage" : "Your pick")</th><th>Points</th></tr>
        </thead>
        <tbody>
            @if (_mode == GameMode.CityCounty)
            {
                @for (int i = 0; i < _mixedResults.Count; i++)
                {
                    var r = _mixedResults[i];
                    // Best city guess = smallest distance; hardest city =
                    // largest distance; best county pick = first correct;
                    // hardest county = first missed.
                    var rowClass = (r == _bestMixedCity || r == _bestMixedCounty) ? "best" : (r == _hardestMixedCity || r == _hardestMixedCounty) ? "hardest" : "";
                    <tr class="@rowClass">
                        <td>@(i + 1)</td>
                        <td>@(r.Round.IsCounty ? r.Round.County!.Name : r.Round.City!.Name)</td>
                        <td>@(r.Round.IsCounty ? (r.SelectedCountyName ?? "—") : r.DistanceMiles is null ? "—" : $"{r.DistanceMiles.Value:F1} mi")</td>
                        <td>@r.Points</td>
                    </tr>
                }
            }
            else if (_mode == GameMode.NameTheCounty)
            {
                @for (int i = 0; i < _nameResults.Count; i++)
                {
                    var r = _nameResults[i];
                    <tr class="@(r == _bestName ? "best" : r == _hardestName ? "hardest" : "")">
                        <td>@(i + 1)</td>
                        <td>@r.CountyName</td>
                        <td>@(r.SelectedCountyName ?? "—")</td>
                        <td>@r.Points</td>
                    </tr>
                }
            }
            else if (_mode == GameMode.Counties)
            {
                @for (int i = 0; i < _countyResults.Count; i++)
                {
                    var r = _countyResults[i];
                    <tr class="@(r == _bestCounty ? "best" : r == _hardestCounty ? "hardest" : "")">
                        <td>@(i + 1)</td>
                        <td>@r.CountyName</td>
                        <td>@(r.OverlapFraction is null ? "—" : $"{r.OverlapFraction.Value * 100:F0}%")</td>
                        <td>@r.Points</td>
                    </tr>
                }
            }
            else
            {
                @for (int i = 0; i < _results.Count; i++)
                {
                    var r = _results[i];
                    <tr class="@(r == _bestGuess ? "best" : r == _hardest ? "hardest" : "")">
                        <td>@(i + 1)</td>
                        <td>@r.City.Name</td>
                        <td>@(r.DistanceMiles is null ? "—" : $"{r.DistanceMiles.Value:F1} mi")</td>
                        <td>@r.Points</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    @if (_mode == GameMode.CityCounty)
    {
        @if (_bestMixedCity is not null)
        {
            <p>Best guess: <strong>@_bestMixedCity.Round.City!.Name</strong> (@_bestMixedCity.DistanceMiles?.ToString("F1") mi, @_bestMixedCity.Points points).</p>
        }
        @if (_hardestMixedCity is not null)
        {
            <p>Hardest city: <strong>@_hardestMixedCity.Round.City!.Name</strong> (@(_hardestMixedCity.DistanceMiles?.ToString("F1") ?? "—") mi, @_hardestMixedCity.Points points).</p>
        }
        @if (_bestMixedCounty is not null)
        {
            <p>Best county pick: <strong>@_bestMixedCounty.Round.County!.Name</strong> — @(_bestMixedCounty.IsAdjacent ? "you picked a neighboring county (50 points)." : "you named it correctly (100 points).")</p>
        }
        @if (_hardestMixedCounty is not null)
        {
            <p>Hardest county: <strong>@_hardestMixedCounty.Round.County!.Name</strong> — you picked @(_hardestMixedCounty.SelectedCountyName ?? "nothing") (@_hardestMixedCounty.Points points).</p>
        }
    }
    else if (_mode == GameMode.NameTheCounty)
    {
        var correctCount = _nameResults.Count(r => r.IsCorrect);
        var adjacentCount = _nameResults.Count(r => r.IsAdjacent);
        <p>You named @correctCount out of @_nameResults.Count counties correctly@(adjacentCount > 0 ? $" and were adjacent on {adjacentCount} more" : "").</p>
        @if (_bestName is not null)
        {
            <p>Best pick: <strong>@_bestName.CountyName</strong> — @(_bestName.IsAdjacent ? "you picked a neighboring county (50 points)." : "you named it correctly (100 points).")</p>
        }
        @if (_hardestName is not null)
        {
            <p>Hardest county: <strong>@_hardestName.CountyName</strong> — you picked @(_hardestName.SelectedCountyName ?? "nothing") (@_hardestName.Points points).</p>
        }
    }
    else if (_mode == GameMode.Counties)
    {
        @if (_bestCounty is not null)
        {
            <p>Best placement: <strong>@_bestCounty.CountyName</strong> (@(_bestCounty.OverlapFraction?.ToString("P0")) covered, @_bestCounty.Points points).</p>
        }
        @if (_hardestCounty is not null)
        {
            <p>Hardest county: <strong>@_hardestCounty.CountyName</strong> (@(_hardestCounty.OverlapFraction?.ToString("P0") ?? "—") covered, @_hardestCounty.Points points).</p>
        }
    }
    else
    {
        @if (_bestGuess is not null)
        {
            <p>Best guess: <strong>@_bestGuess.City.Name</strong> (@_bestGuess.DistanceMiles?.ToString("F1") mi, @_bestGuess.Points points).</p>
        }
        @if (_hardest is not null)
        {
            <p>Hardest city: <strong>@_hardest.City.Name</strong> (@(_hardest.DistanceMiles?.ToString("F1") ?? "—") mi, @_hardest.Points points).</p>
        }
    }

    <div class="button-row">
        <button class="primary" @onclick="PlayAgainNewSeed">Play again (new random game)</button>
        <button @onclick="BackToGameSelection">Back to game selection</button>
    </div>
}

@code {
    private enum Phase { Start, Round, Reveal, Results }

    /// <summary>Which game is being played: pin a city, place a county, name a county, or the City County mix.</summary>
    private enum GameMode { CityCounty, Cities, Counties, NameTheCounty }

    /// <summary>
    /// Which list of cities and counties the game draws from (see
    /// GAME-SPEC §4.6). Risk Pool limits the pool to the pack's
    /// risk-pool members; All uses the full list. The default is Risk
    /// Pool when the pack has one, All otherwise.
    /// </summary>
    private enum Edition { RiskPool, All }

    // Route parameters for the /{state}/{mode}/{seed} URL form, e.g.
    // /oregon/cities/2026-11-06. The mode segment is one of the mode
    // slugs (cities, counties, name-the-county, city-county); /{state}/{mode}
    // (no seed) preselects the mode on the start screen.
    [Parameter] public string? StateId { get; set; }
    [Parameter] public string? ModeParam { get; set; }
    [Parameter] public string? SeedParam { get; set; }

    private StatePack? _pack;
    private bool _loadFailed;
    private string _stateId = "oregon";
    // True when the state came from the URL (/{state}/...),
    // as opposed to the default Oregon when no state is in the URL. The
    // start screen shows the state-specific title ("Where in the Oregon?!")
    // in the header only when the URL named the state.
    private bool _stateFromUrl;
    private string _seedBacking = "";
    // Seeds are forced to upper case, so "friday-game" and "FRIDAY-GAME"
    // are the same game. Every write (typing, URL, Random/Daily) goes
    // through this setter, so the seed is canonical everywhere it is used.
    private string _seed
    {
        get => _seedBacking;
        set => _seedBacking = (value ?? "").ToUpperInvariant();
    }
    private Phase _phase = Phase.Start;
    // The default mode is City County Mode (the first mode button and the
    // one shown in the big preview on first load). A bare /{state}/ URL
    // therefore starts in City County Mode; a mode in the URL overrides it.
    private GameMode _mode = GameMode.CityCounty;
    // The default edition is Risk Pool (when the pack has one). A
    // ?list=all in the URL overrides it to All. Set in
    // OnInitializedAsync, once the pack is loaded.
    private Edition _edition = Edition.RiskPool;
    // "How to play" and "Advanced options" on the start screen are both
    // collapsed (minimized) by default; tapping their buttons expands them.
    private bool _showHowToPlay;
    private bool _showAdvanced;

    private bool _showInterstates = true;
    private bool _showHighways = true;
    private bool _showRivers = true;
    private bool _showLakes = true;

    private List<City> _gameCities = [];
    private List<MapFeature> _gameCounties = [];
    // City County Mode: the 7 city + 3 county rounds, interleaved by a
    // seeded shuffle, and their results in game order.
    private List<MixedRound> _mixedRounds = [];
    private List<MixedRoundResult> _mixedResults = [];
    private int _roundIndex;
    private double? _guessLat;
    private double? _guessLon;
    private List<RoundResult> _results = [];
    private List<CountyRoundResult> _countyResults = [];
    private List<NameTheCountyRoundResult> _nameResults = [];
    private int _totalScore;
    private RoundResult? _bestGuess;
    private RoundResult? _hardest;
    private CountyRoundResult? _bestCounty;
    private CountyRoundResult? _hardestCounty;
    private NameTheCountyRoundResult? _bestName;
    private NameTheCountyRoundResult? _hardestName;
    // City County Mode best/hardest, split by round type: best city guess
    // is the smallest distance, hardest city the largest; best county pick
    // is the first county answered correctly, hardest county the first one
    // missed.
    private MixedRoundResult? _bestMixedCity;
    private MixedRoundResult? _hardestMixedCity;
    private MixedRoundResult? _bestMixedCounty;
    private MixedRoundResult? _hardestMixedCounty;
    private string? _copyMessage;

    // Counties mode: the placed piece's translation in SVG units, from the
    // CountyMapView's drop callback, and whether the piece has been dragged
    // at all this round (Confirm stays disabled until it has — the staging
    // position is not an answer).
    private double _pieceDx;
    private double _pieceDy;
    private bool _countyDragged;

    // "Name the county" mode: the county the player has selected this round.
    private MapFeature? _selectedCounty;

    // ---- Analytics (PostHog) — see GAME-SPEC §13. ----
    // Every tracking call is fire-and-forget and fully guarded: the JS
    // helper checks that the PostHog library loaded, and any failure here
    // (ad blocker, missing library, network down) is swallowed, so the
    // game plays identically with tracking blocked. Nothing here can
    // throw into the game.
    private async Task TrackEventAsync(string eventName, Dictionary<string, object?> props)
    {
        try
        {
            await JS.InvokeVoidAsync("whereInTheState.captureEvent", eventName, props);
        }
        catch
        {
            // Analytics must never break the game.
        }
    }

    // Rounds completed so far, for the game_abandoned context: whichever
    // results list the current mode fills.
    private int CompletedRounds => _mode switch
    {
        GameMode.CityCounty => _mixedResults.Count,
        GameMode.Counties => _countyResults.Count,
        GameMode.NameTheCounty => _nameResults.Count,
        _ => _results.Count
    };

    // The in-progress game's context for the game_abandoned event (fired
    // by the pagehide handler in index.html if the player leaves
    // mid-game). Set when a game starts, updated after every scored
    // round, cleared when the results screen is reached.
    private async Task SetGameContextAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("whereInTheState.setGameContext", new Dictionary<string, object?>
            {
                ["state"] = _stateId,
                ["mode"] = ModeSlug,
                ["edition"] = EditionSlug,
                ["seed"] = _seed,
                ["rounds_completed"] = CompletedRounds,
                ["score_so_far"] = _totalScore
            });
        }
        catch
        {
            // Analytics must never break the game.
        }
    }

    private async Task ClearGameContextAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("whereInTheState.clearGameContext");
        }
        catch
        {
            // Analytics must never break the game.
        }
    }

    // Properties every game event carries.
    private Dictionary<string, object?> BaseProps() => new()
    {
        ["state"] = _stateId,
        ["mode"] = ModeSlug,
        ["edition"] = EditionSlug,
        ["seed"] = _seed
    };

    // A city round was revealed (confirmed or passed). distanceMiles is
    // null for a pass, so the property is omitted, not sent as null.
    // Also refreshes the game_abandoned context (call after the result
    // is recorded, so the round count and score are current).
    private Task TrackCityRoundAsync(City city, double? distanceMiles, int points)
    {
        var props = BaseProps();
        props["round"] = _roundIndex + 1;
        props["question_type"] = "city";
        props["question"] = city.Name;
        // The correct answer, as the grouping key for analysis ("which
        // target is missed most"). Duplicates `question` for city rounds
        // on purpose, so every round_completed event carries one uniform
        // `target` field across all modes.
        props["target"] = city.Name;
        if (distanceMiles is not null)
        {
            props["distance_miles"] = Math.Round(distanceMiles.Value, 1);
        }
        props["points"] = points;
        _ = SetGameContextAsync();
        return TrackEventAsync("round_completed", props);
    }

    // A "Name the county" / City County county round was revealed.
    private Task TrackCountyPickRoundAsync(string countyName, bool correct, bool adjacent, int points)
    {
        var props = BaseProps();
        props["round"] = _roundIndex + 1;
        props["question_type"] = "county";
        props["question"] = countyName;
        // The correct answer, as the grouping key for analysis.
        props["target"] = countyName;
        props["correct"] = correct;
        props["adjacent"] = adjacent;
        props["points"] = points;
        _ = SetGameContextAsync();
        return TrackEventAsync("round_completed", props);
    }

    // A Counties drag round was revealed. Drag scoring is by overlap, so
    // there is no correct/adjacent — the overlap fraction is the metric.
    // overlapFraction is null for a pass, so the property is omitted.
    private Task TrackCountyDragRoundAsync(string countyName, double? overlapFraction, int points)
    {
        var props = BaseProps();
        props["round"] = _roundIndex + 1;
        props["question_type"] = "county";
        props["question"] = countyName;
        // The correct answer, as the grouping key for analysis.
        props["target"] = countyName;
        if (overlapFraction is not null)
        {
            props["overlap_fraction"] = Math.Round(overlapFraction.Value, 3);
        }
        props["points"] = points;
        _ = SetGameContextAsync();
        return TrackEventAsync("round_completed", props);
    }

    // The mode segment of the shareable URL: "cities", "counties",
    // "name-the-county" or "city-county".
    private string ModeSlug => _mode switch
    {
        GameMode.CityCounty => "city-county",
        GameMode.Counties => "counties",
        GameMode.NameTheCounty => "name-the-county",
        _ => "cities"
    };

    // Map a mode slug from the URL to a GameMode, or null when the slug is
    // not a mode at all. An unrecognized mode segment shows the not-found
    // screen, like an unknown state.
    private static GameMode? ModeFromSlug(string? slug) => slug?.ToLowerInvariant() switch
    {
        "cities" => GameMode.Cities,
        "counties" => GameMode.Counties,
        "name-the-county" => GameMode.NameTheCounty,
        "city-county" => GameMode.CityCounty,
        _ => null
    };

    // The edition as a URL slug / analytics value: "risk-pool" or "all".
    // (The URL parameter is named "list": ?list=all. See GAME-SPEC §4.6.)
    private string EditionSlug => _edition == Edition.All ? "all" : "risk-pool";

    // The value of the "list" query parameter in a URL, or null when
    // there is none. Parsed by hand (no WebUtilities dependency): the
    // parameter is a plain token ("all"), so a split on '&' and '='
    // is enough.
    private static string? ListQueryParam(string uri)
    {
        var queryStart = uri.IndexOf('?');
        if (queryStart < 0)
        {
            return null;
        }
        var query = uri[(queryStart + 1)..];
        var hashStart = query.IndexOf('#');
        if (hashStart >= 0)
        {
            query = query[..hashStart];
        }
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            var key = eq < 0 ? pair : pair[..eq];
            if (string.Equals(Uri.UnescapeDataString(key), "list", StringComparison.OrdinalIgnoreCase))
            {
                return eq < 0 ? "" : Uri.UnescapeDataString(pair[(eq + 1)..]);
            }
        }
        return null;
    }

    // The edition as shown in the results summary: "Risk Pool Edition"
    // or "All Edition", on its own line so it reads at a glance.
    private string EditionSummaryLabel => _edition == Edition.All ? "All Edition" : "Risk Pool Edition";

    // The pools the next game draws from. In the Risk Pool edition the
    // pool is the pack's risk-pool members only, filtered by exact name
    // against the pack's cities/counties — the filter applies BEFORE
    // the seeded shuffle, so the seed + edition together determine the
    // game. In the All edition (or a pack without a risk pool) the pool
    // is the full list. No names are hard-coded here.
    private IReadOnlyList<City> CityPool => _edition == Edition.RiskPool && _pack?.RiskPool is not null
        ? _pack.Cities.Where(c => _pack.RiskPool.Cities.Contains(c.Name, StringComparer.Ordinal)).ToList()
        : _pack?.Cities ?? [];

    private IReadOnlyList<MapFeature> CountyPool => _edition == Edition.RiskPool && _pack?.RiskPool is not null
        ? _pack.Counties.Where(c => c.Name is not null && _pack.RiskPool.Counties.Contains(c.Name, StringComparer.Ordinal)).ToList()
        : _pack?.Counties ?? [];

    private string ModeSummaryLabel => _mode switch
    {
        GameMode.CityCounty => " (City/County)",
        GameMode.Counties => " (Counties)",
        GameMode.NameTheCounty => " (County)",
        _ => ""
    };

    // What the seed picks, for the start-screen hint: cities, counties,
    // or (in City County Mode) 7 cities and 3 counties.
    private string SeedPoolLabel => _mode switch
    {
        GameMode.CityCounty => "7 cities and 3 counties",
        GameMode.Cities => "cities",
        _ => "counties"
    };

    // Every mode is 100 points per question and 1000 per game, so every
    // score display (progress bar, score chip, results hero, summary)
    // reads the same maximum. ("Name the county" was 1 point per correct
    // answer, 10 per game, until 2026-11-08; it now scores like the other
    // modes — see §6.5.)
    private int MaxScore => 1000;

    // Points for one correct answer in the current mode: 100 everywhere.
    private int PointsPerRound => 100;

    // The shareable game link: /{state}/{mode}/{seed}, plus ?list=all
    // when the edition is All. The Risk Pool edition (the default)
    // carries no parameter, so its URLs stay exactly as before — the
    // same seed with a different edition picks different questions, so
    // the link must carry the edition to reproduce the same game.
    private string GameLink =>
        Navigation.ToAbsoluteUri(
            $"{Uri.EscapeDataString(_stateId)}/{ModeSlug}/{Uri.EscapeDataString(_seed)}" +
            (_edition == Edition.All ? "?list=all" : "")).ToString();

    private string SummaryText =>
        $"I scored {_totalScore}/{MaxScore} on Where in the {_pack?.Name ?? "Oregon"}?!" +
        ModeSummaryLabel +
        $", Game # {_seed}\n{EditionSummaryLabel}\nPlay the same game: {GameLink}";

    // Once a game starts, the header shows the in-game title, derived
    // from the pack name so a future state gets its own title with no
    // code change — and it stays that way through the results screen.
    // Before a game starts it is the product name.
    private string TitleForPhase(Phase phase) =>
        ((phase is Phase.Round or Phase.Reveal or Phase.Results) ||
         (phase == Phase.Start && _stateFromUrl)) && _pack is not null
            ? $"Where in the {_pack.Name}?!"
            : "Where in the State";

    private string PageTitleText =>
        (_phase is Phase.Round or Phase.Reveal or Phase.Results) && _pack is not null
            ? TitleForPhase(_phase)
            : "Where in the State — Oregon";

    private void SetPhase(Phase phase)
    {
        _phase = phase;
        HeaderTitle.SetTitle(TitleForPhase(phase));
        if (phase == Phase.Results)
        {
            // The game is over: report it, and clear the abandonment
            // context so leaving the results screen is not an abandonment.
            // (The game has no per-round or total timing, so no duration
            // is reported — see GAME-SPEC §13.)
            var props = BaseProps();
            props["total_score"] = _totalScore;
            props["max_score"] = MaxScore;
            props["rounds"] = 10;
            _ = TrackEventAsync("game_completed", props);
            _ = ClearGameContextAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Resolve the state, mode and seed from the URL path:
        // /{state}/{mode}/{seed}, e.g. /oregon/cities/2026-11-06.
        // /{state}/{mode} (no seed) preselects the mode on the start
        // screen; /{state} or / shows the start screen with the default
        // mode (City County Mode). No state/seed in the URL means Oregon with
        // today's daily seed. There is no query-string form any more.
        if (!string.IsNullOrWhiteSpace(StateId))
        {
            _stateId = StateId.Trim().ToLowerInvariant();
            _stateFromUrl = true;
        }

        // State ids are pack directory names under data/states/, so they
        // may only be lowercase letters, digits and hyphens. Anything
        // else (e.g. "../", "%2e%2e", spaces) can never be a real pack
        // and must not reach the loader as a path segment.
        if (_stateId.Length == 0 || _stateId.Any(c => !(c is >= 'a' and <= 'z' or >= '0' and <= '9' or '-')))
        {
            _loadFailed = true;
            return;
        }

        // An unrecognized mode segment is not a game URL at all: show the
        // not-found screen, like an unknown state.
        if (!string.IsNullOrWhiteSpace(ModeParam))
        {
            var modeFromUrl = ModeFromSlug(ModeParam);
            if (modeFromUrl is null)
            {
                _loadFailed = true;
                return;
            }
            _mode = modeFromUrl.Value;
        }

        // If the state pack can't be loaded (unknown state, missing or
        // broken data, network error), show the not-found screen instead
        // of hanging on "Loading the map…" forever. LoadAsync throws on
        // a 404 for data/states/<id>/state.json, so catch here.
        try
        {
            _pack = await PackLoader.LoadAsync(_stateId);
        }
        catch (Exception)
        {
            _pack = null;
            _loadFailed = true;
            return;
        }

        if (_pack is null || _pack.Cities.Count == 0)
        {
            // A pack with no cities can't produce a game: StartGame would
            // index _gameCities[0] out of range.
            _loadFailed = true;
            return;
        }

        // A pack with no counties can't play any county mode, so the mode
        // falls back to Cities.
        if (_pack.Counties.Count == 0 &&
            _mode is GameMode.CityCounty or GameMode.Counties or GameMode.NameTheCounty)
        {
            _mode = GameMode.Cities;
        }

        // The default edition is Risk Pool when the pack has one; a pack
        // without a risk pool has no Risk Pool edition and plays All.
        // ?list=all in the URL overrides the default to All, so a shared
        // All-edition link opens in the All edition. Any other value (or
        // none) leaves the default.
        _edition = _pack.RiskPool is not null ? Edition.RiskPool : Edition.All;
        if (string.Equals(ListQueryParam(Navigation.Uri), "all", StringComparison.OrdinalIgnoreCase))
        {
            _edition = Edition.All;
        }

        _seed = !string.IsNullOrWhiteSpace(SeedParam)
            ? SeedParam
            : GameService.DailySeed();

        // Landmark defaults come from the pack manifest.
        foreach (var layer in _pack.Layers)
        {
            switch (layer.Id)
            {
                case "interstate": _showInterstates = layer.VisibleByDefault; break;
                case "highway": _showHighways = layer.VisibleByDefault; break;
                case "river": _showRivers = layer.VisibleByDefault; break;
                case "lake": _showLakes = layer.VisibleByDefault; break;
            }
        }

        // The header title on the start screen follows the same rule as
        // TitleForPhase: when the URL named the state, the header already
        // says "Where in the Oregon?!" before a game starts.
        HeaderTitle.SetTitle(TitleForPhase(Phase.Start));
    }

    private void PlayOregon()
    {
        // Back to the Oregon start screen. The app root ("/") is the
        // splash page now, so going there would add a step; the button
        // says "Play Oregon", so go straight to /oregon/.
        Navigation.NavigateTo(Navigation.ToAbsoluteUri("oregon/").ToString(), forceLoad: true);
    }

    private void UseRandomSeed() => _seed = GameService.RandomSeed();

    private void UseDailySeed() => _seed = GameService.DailySeed();

    // The main Play button reads "Play Today's Game" when the box holds
    // today's daily seed, and just "Play" for any other seed (or an empty
    // box). _seed is forced to upper case by its setter and DailySeed is
    // already upper case, so a plain == is a canonical comparison. The
    // input binds on every keystroke, so the label updates reactively.
    private bool IsDailySeed => _seed == GameService.DailySeed();

    private void StartGame()
    {
        if (_pack is null || string.IsNullOrWhiteSpace(_seed))
        {
            return;
        }

        _seed = _seed.Trim();
        if (_mode == GameMode.CityCounty)
        {
            // 7 cities and 3 counties, then the 10 rounds interleaved by
            // a seeded shuffle — genuinely mixed, not 7-then-3. The same
            // seed picks the same 7 cities and 3 counties (same selection
            // as the single-type modes), only their order is shuffled.
            // The pools are the edition's pools (CityPool/CountyPool):
            // the filter applies before the shuffle, so the seed +
            // edition together determine the game.
            _gameCities = GameService.SelectCities(CityPool, _seed, count: 7).ToList();
            _gameCounties = GameService.SelectItems(CountyPool, _seed, count: 3).ToList();
            if (_gameCities.Count == 0 || _gameCounties.Count == 0)
            {
                return;
            }
            var mixed = _gameCities.Select(c => new MixedRound(c, null))
                .Concat(_gameCounties.Select(c => new MixedRound(null, c)))
                .ToList();
            _mixedRounds = GameService.Shuffle(mixed, _seed).ToList();
            _mixedResults = [];
        }
        else if (_mode == GameMode.Counties || _mode == GameMode.NameTheCounty)
        {
            _gameCounties = GameService.SelectItems(CountyPool, _seed, count: 10).ToList();
            if (_gameCounties.Count == 0)
            {
                return;
            }
            _gameCities = [];
            _mixedRounds = [];
        }
        else
        {
            _gameCities = GameService.SelectCities(CityPool, _seed, count: 10).ToList();
            if (_gameCities.Count == 0)
            {
                return;
            }
            _gameCounties = [];
            _mixedRounds = [];
        }
        _roundIndex = 0;
        _results = [];
        _countyResults = [];
        _nameResults = [];
        _mixedResults = [];
        _totalScore = 0;
        _bestGuess = null;
        _hardest = null;
        _bestCounty = null;
        _hardestCounty = null;
        _bestName = null;
        _hardestName = null;
        _bestMixedCity = null;
        _hardestMixedCity = null;
        _bestMixedCounty = null;
        _hardestMixedCounty = null;
        _guessLat = null;
        _guessLon = null;
        _pieceDx = 0;
        _pieceDy = 0;
        _countyDragged = false;
        _selectedCounty = null;
        _copyMessage = null;
        SetPhase(Phase.Round);

        // Report the game start (and set the abandonment context) before
        // the URL is rewritten — the navigation is in-app, so the page
        // is not unloaded and the interop calls still run.
        var startedProps = BaseProps();
        startedProps["questions"] = 10;
        _ = TrackEventAsync("game_started", startedProps);
        _ = SetGameContextAsync();

        // Write the game into the URL so it is shareable / refresh-safe.
        // ToAbsoluteUri resolves the relative path against the app's base
        // address, so this works both locally (/) and on GitHub Pages
        // (/where-in-the-state/). The URL is /{state}/{mode}/{seed}.
        Navigation.NavigateTo(Navigation.ToAbsoluteUri(GameLink).ToString());
    }

    private void OnMapClicked((double Latitude, double Longitude) point)
    {
        // Provisional pin: click again to move it; nothing is scored yet.
        _guessLat = point.Latitude;
        _guessLon = point.Longitude;
    }

    private void ConfirmGuess()
    {
        if (_mode == GameMode.Counties)
        {
            ConfirmCountyPlacement();
            return;
        }

        if (_mode == GameMode.NameTheCounty)
        {
            ConfirmCountySelection();
            return;
        }

        if (_mode == GameMode.CityCounty)
        {
            ConfirmMixedRound();
            return;
        }

        if (_guessLat is null || _guessLon is null)
        {
            return;
        }

        var city = _gameCities[_roundIndex];
        double distance = DistanceService.HaversineMiles(
            _guessLat.Value, _guessLon.Value, city.Latitude, city.Longitude);
        int points = DistanceService.ScoreForDistance(distance);
        _results.Add(new RoundResult(city, _guessLat, _guessLon, distance, points));
        _totalScore += points;
        _ = TrackCityRoundAsync(city, distance, points);
        SetPhase(Phase.Reveal);
    }

    /// <summary>
    /// Confirm one City County Mode round. A county round scores 100 for
    /// naming the right county, 50 for a county sharing a border with it,
    /// 0 otherwise; a city round scores by distance, exactly like Cities
    /// mode. See GAME-SPEC §6.6.
    /// </summary>
    private void ConfirmMixedRound()
    {
        var round = _mixedRounds[_roundIndex];
        if (round.IsCounty)
        {
            if (_selectedCounty is null)
            {
                return;
            }

            var county = round.County!;
            bool correct = string.Equals(
                _selectedCounty.Name, county.Name, StringComparison.Ordinal);
            bool adjacent = !correct && county.IsNeighbor(_selectedCounty.Name);
            int points = correct ? 100 : adjacent ? 50 : 0;
            _mixedResults.Add(new MixedRoundResult(round, null, _selectedCounty.Name, correct, adjacent, points));
            _totalScore += points;
            _ = TrackCountyPickRoundAsync(county.Name ?? "", correct, adjacent, points);
            SetPhase(Phase.Reveal);
            return;
        }

        if (_guessLat is null || _guessLon is null)
        {
            return;
        }

        var city = round.City!;
        double distance = DistanceService.HaversineMiles(
            _guessLat.Value, _guessLon.Value, city.Latitude, city.Longitude);
        int cityPoints = DistanceService.ScoreForDistance(distance);
        _mixedResults.Add(new MixedRoundResult(round, distance, null, null, false, cityPoints));
        _totalScore += cityPoints;
        _ = TrackCityRoundAsync(city, distance, cityPoints);
        SetPhase(Phase.Reveal);
    }

    private void ConfirmCountySelection()
    {
        if (_selectedCounty is null || _roundIndex >= _gameCounties.Count)
        {
            return;
        }

        var county = _gameCounties[_roundIndex];
        // 100 points for the right county, 50 for a county sharing a
        // border with it ("Pretty close!"), 0 for any other county.
        // Adjacency comes from the pack data (MapFeature.Neighbors).
        bool correct = string.Equals(
            _selectedCounty.Name, county.Name, StringComparison.Ordinal);
        bool adjacent = !correct && county.IsNeighbor(_selectedCounty.Name);
        int points = correct ? 100 : adjacent ? 50 : 0;
        _nameResults.Add(new NameTheCountyRoundResult(
            county.Name ?? "", _selectedCounty.Name, correct, adjacent, points));
        _totalScore += points;
        _ = TrackCountyPickRoundAsync(county.Name ?? "", correct, adjacent, points);
        SetPhase(Phase.Reveal);
    }

    private void OnCountySelected(MapFeature? county) => _selectedCounty = county;

    private void ConfirmCountyPlacement()
    {
        if (!_countyDragged || _roundIndex >= _gameCounties.Count)
        {
            return;
        }

        var county = _gameCounties[_roundIndex];
        double overlap = OverlapService.OverlapFraction(CountySvgRings(county), _pieceDx, _pieceDy);
        int points = OverlapService.ScoreForOverlap(overlap);
        _countyResults.Add(new CountyRoundResult(county.Name ?? "", overlap, points));
        _totalScore += points;
        _ = TrackCountyDragRoundAsync(county.Name ?? "", overlap, points);
        SetPhase(Phase.Reveal);
    }

    /// <summary>
    /// The county's rings in SVG coordinates, for overlap scoring. The
    /// projection is linear, so area ratios in SVG space equal area ratios
    /// on the ground (see OverlapService).
    /// </summary>
    private static List<IReadOnlyList<(double X, double Y)>> CountySvgRings(MapFeature county)
    {
        var result = new List<IReadOnlyList<(double X, double Y)>>();
        foreach (var ring in county.Parts)
        {
            var projected = new List<(double X, double Y)>(ring.Count);
            foreach (var (lon, lat) in ring)
            {
                projected.Add(MapProjection.LatLonToSvg(lat, lon));
            }
            result.Add(projected);
        }

        return result;
    }

    private void OnPieceDragged() => _countyDragged = true;

    private void OnPieceDropped((double Dx, double Dy) translation)
    {
        _pieceDx = translation.Dx;
        _pieceDy = translation.Dy;
    }

    private void Pass()
    {
        if (_mode == GameMode.CityCounty)
        {
            var round = _mixedRounds[_roundIndex];
            if (round.IsCounty)
            {
                _mixedResults.Add(new MixedRoundResult(round, null, null, false, false, 0));
                _ = TrackCountyPickRoundAsync(round.County!.Name ?? "", false, false, 0);
                _selectedCounty = null;
            }
            else
            {
                _mixedResults.Add(new MixedRoundResult(round, null, null, null, false, 0));
                _ = TrackCityRoundAsync(round.City!, null, 0);
                _guessLat = null;
                _guessLon = null;
            }
            SetPhase(Phase.Reveal);
            return;
        }

        if (_mode == GameMode.NameTheCounty)
        {
            var namedCounty = _gameCounties[_roundIndex];
            _nameResults.Add(new NameTheCountyRoundResult(namedCounty.Name ?? "", null, false, false, 0));
            _ = TrackCountyPickRoundAsync(namedCounty.Name ?? "", false, false, 0);
            _selectedCounty = null;
            SetPhase(Phase.Reveal);
            return;
        }

        if (_mode == GameMode.Counties)
        {
            var county = _gameCounties[_roundIndex];
            _countyResults.Add(new CountyRoundResult(county.Name ?? "", null, 0));
            _ = TrackCountyDragRoundAsync(county.Name ?? "", null, 0);
            _pieceDx = 0;
            _pieceDy = 0;
            _countyDragged = false;
            SetPhase(Phase.Reveal);
            return;
        }

        var city = _gameCities[_roundIndex];
        _results.Add(new RoundResult(city, null, null, null, 0));
        _ = TrackCityRoundAsync(city, null, 0);
        _guessLat = null;
        _guessLon = null;
        SetPhase(Phase.Reveal);
    }

    private void NextRound()
    {
        _guessLat = null;
        _guessLon = null;
        _pieceDx = 0;
        _pieceDy = 0;
        _countyDragged = false;
        _selectedCounty = null;
        if (_mode == GameMode.CityCounty)
        {
            if (_roundIndex + 1 >= _mixedRounds.Count)
            {
                var cityScored = _mixedResults
                    .Where(r => !r.Round.IsCounty && r.DistanceMiles is not null).ToList();
                // MinBy/MaxBy throw on an empty sequence, and cityScored is
                // empty when every city round was passed — then there is no
                // best or hardest guess to show.
                _bestMixedCity = cityScored.Count > 0 ? cityScored.MinBy(r => r.DistanceMiles) : null;
                _hardestMixedCity = cityScored.Count > 0 ? cityScored.MaxBy(r => r.DistanceMiles) : null;
                // Best county pick = the first county answered correctly;
                // if none was, the first adjacent pick (50 points) instead.
                // Hardest county = the first one missed (preferring a
                // picked wrong county over a pass).
                _bestMixedCounty = _mixedResults.FirstOrDefault(r => r.Round.IsCounty && r.IsCorrect == true)
                    ?? _mixedResults.FirstOrDefault(r => r.Round.IsCounty && r.IsAdjacent);
                _hardestMixedCounty = _mixedResults.FirstOrDefault(r => r.Round.IsCounty && r.IsCorrect == false && r.SelectedCountyName is not null)
                    ?? _mixedResults.FirstOrDefault(r => r.Round.IsCounty && r.IsCorrect == false);
                SetPhase(Phase.Results);
            }
            else
            {
                _roundIndex++;
                SetPhase(Phase.Round);
            }
            return;
        }

        if (_mode == GameMode.NameTheCounty)
        {
            if (_roundIndex + 1 >= _gameCounties.Count)
            {
                // Best = the first county named correctly — or, if none
                // was, the first adjacent pick (50 points). Hardest = the
                // first one missed. The results screen also shows how many
                // were named correctly (and adjacent) out of 10.
                _bestName = _nameResults.FirstOrDefault(r => r.IsCorrect)
                    ?? _nameResults.FirstOrDefault(r => r.IsAdjacent);
                _hardestName = _nameResults.FirstOrDefault(r => !r.IsCorrect && r.SelectedCountyName is not null)
                    ?? _nameResults.FirstOrDefault(r => !r.IsCorrect);
                SetPhase(Phase.Results);
            }
            else
            {
                _roundIndex++;
                SetPhase(Phase.Round);
            }
            return;
        }

        if (_mode == GameMode.Counties)
        {
            if (_roundIndex + 1 >= _gameCounties.Count)
            {
                var scored = _countyResults.Where(r => r.OverlapFraction is not null).ToList();
                // MinBy/MaxBy throw on an empty sequence, and scored is empty
                // when the player passed every round — then there is no best
                // or hardest county to show.
                _bestCounty = scored.Count > 0 ? scored.MaxBy(r => r.OverlapFraction) : null;
                _hardestCounty = scored.Count > 0 ? scored.MinBy(r => r.OverlapFraction) : null;
                SetPhase(Phase.Results);
            }
            else
            {
                _roundIndex++;
                SetPhase(Phase.Round);
            }
            return;
        }

        if (_roundIndex + 1 >= _gameCities.Count)
        {
            var scored = _results.Where(r => r.DistanceMiles is not null).ToList();
            // MinBy/MaxBy throw on an empty sequence, and scored is empty
            // when the player passed every round — then there is no best
            // or hardest guess to show. _bestGuess/_hardest are nullable
            // and the results screen already handles null.
            _bestGuess = scored.Count > 0 ? scored.MinBy(r => r.DistanceMiles) : null;
            _hardest = scored.Count > 0 ? scored.MaxBy(r => r.DistanceMiles) : null;
            SetPhase(Phase.Results);
        }
        else
        {
            _roundIndex++;
            SetPhase(Phase.Round);
        }
    }

    private void PlayAgainNewSeed()
    {
        _seed = GameService.RandomSeed();
        StartGame();
    }

    private void BackToGameSelection()
    {
        // Back to the state start screen (game selection: mode picker
        // and seed). Force a full reload so the page re-initializes to
        // the start screen: an in-app navigation to the same component
        // would not re-run OnInitializedAsync, so the phase would stay
        // on Results. The ?list=all suffix is kept when the edition is
        // All, so going back does not silently reset the edition.
        Navigation.NavigateTo(Navigation.ToAbsoluteUri(
            $"{Uri.EscapeDataString(_stateId)}/" +
            (_edition == Edition.All ? "?list=all" : "")).ToString(), forceLoad: true);
    }

    private async Task CopySummary()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", SummaryText);
            _copyMessage = "Summary copied.";
        }
        catch
        {
            // Kept to one line so it fits the reserved status line.
            _copyMessage = "Copy didn't work in this browser.";
        }
    }

}
